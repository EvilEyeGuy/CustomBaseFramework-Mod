<?xml version="1.0" encoding="utf-8"?>
<!-- Variante von TownWall mit einer Schiessscharte in der Aussenschale.

     Sie steht hier, weil aus einer geschlossenen Mauer in RimWorld niemand
     herausschiessen kann. Das Mauerprofil stempelt seine Streifen der Reihe
     nach entlang des Laufs, also ergibt eine Liste aus dreimal TownWall und
     einmal dieser Variante jede vierte Zelle eine Scharte.

     Der Rest ist Zeichen fuer Zeichen TownWall. Wer die Scharte anders
     verteilt oder anders gezeichnet haben will, aendert entweder diese Datei
     oder die segments-Liste im Mauerprofil. -->
<Defs>

  <CustomBaseFramework.PieceDef>
    <defName>TownWall_Scharte</defName>
    <label>TownWall_Scharte</label>
    <schemaVersion>2</schemaVersion>
    <categories>
      <li>WallSegment</li>
    </categories>
    <type>WallPart</type>
    <style>Standard</style>

    <legend>
      <li MayRequire="DankPyon.Medieval.Overhaul"><symbol>W</symbol><terrain>DankPyon_Floor_Cobblestone_Granite</terrain></li>
      <li><symbol>D</symbol><roof>RoofConstructed</roof></li>
      <li MayRequire="DankPyon.Medieval.Overhaul"><symbol>T</symbol><thing>DankPyon_CastleWall</thing><stuff>BlocksGranite</stuff></li>
      <li MayRequire="DankPyon.Medieval.Overhaul"><symbol>B</symbol><thing>DankPyon_CastleWallEmbrasures</thing><stuff>BlocksGranite</stuff></li>
    </legend>

    <mask>
      <li>#</li>
      <li>#</li>
      <li>#</li>
    </mask>

    <terrain>
      <li>W</li>
      <li>W</li>
      <li>W</li>
    </terrain>

    <things>
      <li>B</li>
      <li>.</li>
      <li>T</li>
    </things>

    <roof>
      <li>D</li>
      <li>D</li>
      <li>D</li>
    </roof>
  </CustomBaseFramework.PieceDef>

</Defs>
