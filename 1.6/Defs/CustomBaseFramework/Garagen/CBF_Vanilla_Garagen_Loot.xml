<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.LootTableDef>
    <defName>CBF_Vanilla_Goods_CarParts</defName>
    <label>car parts</label>
    <rolls>1~1</rolls>
