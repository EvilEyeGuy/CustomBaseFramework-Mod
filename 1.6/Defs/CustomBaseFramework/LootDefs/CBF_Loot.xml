      <li MayRequire="DankPyon.Medieval.Overhaul"><thing>DankPyon_Crate1x2c</thing><bleibt>true</bleibt></li>
      <li MayRequire="DankPyon.Medieval.Overhaul"><thing>DankPyon_SackClosed</thing><bleibt>true</bleibt></li>
      <li><thing>Shelf</thing><bleibt>true</bleibt></li>
    </members>
  </CustomBaseFramework.LootBuildingCategoryDef>

