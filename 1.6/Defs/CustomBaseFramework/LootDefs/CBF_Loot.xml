<?xml version="1.0" encoding="utf-8"?>
<Defs>





  <!-- ==================================================================
       Lootkategorien. Sie sagen, welche Gebaeude in einer Inhaltszone
       stehen duerfen. Reine Zeichenketten, damit keine fremden Defs
       gepatcht werden muessen und ein fehlender Eintrag einfach wegfaellt.
       ================================================================== -->

  <!-- Lootkategorien. Nur Behaelter mit freiem Filter, sonst legt RimWorld die
       Beute neben den Behaelter statt hinein. Ein Eintrag je Groesse, denn der
       Placer nimmt den groessten, der passt, und wuerfelt unter gleich grossen.
       Vanilla Shelf steht immer zuletzt als Rueckfall. -->

  <CustomBaseFramework.LootBuildingCategoryDef>
    <defName>CBF_Cat_Kueche</defName>
    <label>Kueche</label>
    <members>
      <li MayRequire="DankPyon.Medieval.Overhaul"><thing>DankPyon_LargeShelfEmpty</thing><bleibt>true</bleibt></li>
      <li MayRequire="DankPyon.Medieval.Overhaul"><thing>DankPyon_RusticCupboardEmpty</thing><bleibt>true</bleibt></li>
      <li MayRequire="DankPyon.Medieval.Overhaul"><thing>DankPyon_ShelfEmpty</thing><bleibt>true</bleibt></li>
      <li MayRequire="DankPyon.Medieval.Overhaul"><thing>DankPyon_RusticBarrelClosed</thing><bleibt>true</bleibt></li>
      <li><thing>Shelf</thing><bleibt>true</bleibt></li>
    </members>
  </CustomBaseFramework.LootBuildingCategoryDef>

  <CustomBaseFramework.LootBuildingCategoryDef>
    <defName>CBF_Cat_Vorrat</defName>
    <label>Vorrat</label>
