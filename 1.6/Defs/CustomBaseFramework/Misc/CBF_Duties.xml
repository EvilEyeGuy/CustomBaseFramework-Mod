<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <DutyDef>
    <defName>CBF_Hold</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_TakeCombatEnhancingDrug">
          <onlyIfInDanger>true</onlyIfInDanger>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Abilities_Aggressive</treeDef>
        </li>
        <li Class="CustomBaseFramework.JobGiver_CBFGefecht">
          <targetAcquireRadius>50</targetAcquireRadius>
          <targetKeepRadius>60</targetKeepRadius>
          <maxDistFromSelf>25</maxDistFromSelf>
        </li>
        <li Class="JobGiver_AIDefendPoint">
          <targetAcquireRadius>50</targetAcquireRadius>
          <targetKeepRadius>60</targetKeepRadius>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>SatisfyBasicNeeds</treeDef>
        </li>
        <li Class="JobGiver_SeekSafeTemperature" />
        <li Class="ThinkNode_ConditionalCloseToDutyTarget">
          <maxDistToDutyTarget>12</maxDistToDutyTarget>
          <subNodes>
            <li Class="JobGiver_WanderAnywhere">
              <wanderRadius>12</wanderRadius>
            </li>
          </subNodes>
        </li>
        <li Class="JobGiver_WanderNearDutyLocation" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>CBF_Walkway</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Abilities_Aggressive</treeDef>
        </li>
        <li Class="CustomBaseFramework.JobGiver_CBFWalkway">
          <targetAcquireRadius>60</targetAcquireRadius>
          <targetKeepRadius>70</targetKeepRadius>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>SatisfyBasicNeeds</treeDef>
        </li>
        <li Class="JobGiver_SeekSafeTemperature" />
        <li Class="JobGiver_WanderNearDutyLocation" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>CBF_Shelter</defName>
    <alwaysShowWeapon>false</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_AIDefendSelf">
          <targetAcquireRadius>8</targetAcquireRadius>
          <targetKeepRadius>12</targetKeepRadius>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>SatisfyVeryUrgentNeeds</treeDef>
        </li>
        <li Class="JobGiver_SeekSafeTemperature" />
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>6</wanderRadius>
          <locomotionUrgencyOutsideRadius>Sprint</locomotionUrgencyOutsideRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>CBF_Relief</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_TakeCombatEnhancingDrug">
          <onlyIfInDanger>true</onlyIfInDanger>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Abilities_Aggressive</treeDef>
        </li>
        <li Class="CustomBaseFramework.JobGiver_CBFGefecht">
          <targetAcquireRadius>40</targetAcquireRadius>
          <targetKeepRadius>50</targetKeepRadius>
          <maxDistFromSelf>25</maxDistFromSelf>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>SatisfyVeryUrgentNeeds</treeDef>
        </li>
        <li Class="JobGiver_WanderNearDutyLocation">
          <locomotionUrgencyOutsideRadius>Sprint</locomotionUrgencyOutsideRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

</Defs>
