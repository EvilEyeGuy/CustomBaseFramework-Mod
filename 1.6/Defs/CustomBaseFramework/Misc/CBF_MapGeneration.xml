<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Der Anschluss an RimWorlds Kartenerzeugung.

       CBF_Settlement ist der Schritt, der einen Ort baut. Er liest den Ortstyp
       vom Weltobjekt, wenn dort einer steht, sonst waehlt er einen passenden
       aus. Er wirft nie: findet er nichts, bleibt die Karte leer, statt dass
       das Spiel abbricht.

       Wer eigene Weltobjekte hat, setzt bei ihnen
         <mapGenerator>CBF_Base_Faction</mapGenerator>
       Wer stattdessen alle Fraktionsbasen umstellen will, patcht die genSteps
       von Base_Faction. Das Beispiel dafuer steht in Patches. -->

  <GenStepDef>
    <defName>CBF_Settlement</defName>
    <order>400</order>
    <genStep Class="CustomBaseFramework.GenStep_CBFSettlement">
      <spawnPawns>true</spawnPawns>
    </genStep>
  </GenStepDef>

  <!-- Wie CBF_Settlement, aber ohne Bewohner. Fuer Ruinen und Questorte. -->
  <GenStepDef>
    <defName>CBF_SettlementEmpty</defName>
    <order>400</order>
    <genStep Class="CustomBaseFramework.GenStep_CBFSettlement">
      <spawnPawns>false</spawnPawns>
    </genStep>
  </GenStepDef>

  <MapGeneratorDef ParentName="MapCommonBase">
    <defName>CBF_Base_Faction</defName>
    <genSteps>
      <li>CBF_Gelaende</li>
      <li>RocksFromGrid</li>
      <li>CBF_Settlement</li>
      <li>SettlementPower</li>
    </genSteps>
  </MapGeneratorDef>

  <MapGeneratorDef ParentName="MapCommonBase">
    <defName>CBF_Base_Abandoned</defName>
    <genSteps>
      <li>RocksFromGrid</li>
      <li>CBF_SettlementEmpty</li>
    </genSteps>
  </MapGeneratorDef>

</Defs>
