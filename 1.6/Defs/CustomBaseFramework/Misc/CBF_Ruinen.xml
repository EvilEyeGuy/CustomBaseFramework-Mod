<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.RuinDef Name="CBF_Ruin_Basis" Abstract="True">
    <occupation>Occupier</occupation>
  </CustomBaseFramework.RuinDef>

  <CustomBaseFramework.RuinDef Name="CBF_Ruin_Raided" ParentName="CBF_Ruin_Basis">
    <defName>CBF_Ruin_Raided</defName>
    <label>raided</label>
    <wallDemolition>0.15</wallDemolition>
    <clustering>0.7</clustering>
    <breaches>1~3</breaches>
    <gateDestroyed>0.5</gateDestroyed>
    <buildingDamage>0.1~0.5</buildingDamage>
    <turretsDestroyed>0.5</turretsDestroyed>
    <burnMarks>0.2</burnMarks>
    <fires>0~3</fires>
    <rubble>0.3</rubble>
    <lootFactor>0.4</lootFactor>
    <lootWithOccupiers>0.5</lootWithOccupiers>
    <residentCorpses>4~10</residentCorpses>
    <attackerCorpses>2~6</attackerCorpses>
    <rotDays>0.5~3</rotDays>
    <prisoners>0~3</prisoners>
    <fieldsRavaged>0.3</fieldsRavaged>
    <livestockGone>0.6</livestockGone>
  </CustomBaseFramework.RuinDef>

  <CustomBaseFramework.RuinDef>
    <defName>CBF_Ruin_Plundered</defName>
    <label>plundered</label>
    <occupation>Builder</occupation>
    <wallDemolition>0.25</wallDemolition>
    <clustering>0.6</clustering>
    <buildingDamage>0.2~0.6</buildingDamage>
    <burnMarks>0.3</burnMarks>
    <rubble>0.45</rubble>
    <roofCollapse>0.4</roofCollapse>
    <overgrowth>0.35</overgrowth>
    <overgrowthTrees>0.2</overgrowthTrees>
    <lootFactor>0.35</lootFactor>
    <lootWithOccupiers>0</lootWithOccupiers>
    <residentCorpses>1~4</residentCorpses>
    <rotDays>20~60</rotDays>
  </CustomBaseFramework.RuinDef>

  <CustomBaseFramework.RuinDef>
    <defName>CBF_Ruin_Unplundered</defName>
    <label>not plundered</label>
    <occupation>Builder</occupation>
    <wallDemolition>0.25</wallDemolition>
    <clustering>0.6</clustering>
    <buildingDamage>0.2~0.6</buildingDamage>
    <burnMarks>0.25</burnMarks>
    <rubble>0.45</rubble>
    <roofCollapse>0.4</roofCollapse>
    <overgrowth>0.35</overgrowth>
    <overgrowthTrees>0.2</overgrowthTrees>
    <lootFactor>1</lootFactor>
    <lootWithOccupiers>0</lootWithOccupiers>
  </CustomBaseFramework.RuinDef>

</Defs>
