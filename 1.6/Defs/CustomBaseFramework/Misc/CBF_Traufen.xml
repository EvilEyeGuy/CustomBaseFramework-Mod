        <traufe>AR_EaveStony</traufe>
        <eckeAussen>AR_StonyEaveOuterCorner</eckeAussen>
        <eckeInnen>AR_StonyEaveInnerCornerSmall</eckeInnen>
        <stuffChain>
          <li>DankPyon_BlocksClay</li>
          <li>BlocksSandstone</li>
          <li>BlocksGranite</li>
        </stuffChain>
      </li>

      <li>
        <stuffCategory>Woody</stuffCategory>
