          <li>SameAsWall</li>
          <li>WoodLog</li>
        </stuffChain>
      </li>

      <li>
        <stuffCategory>Stony</stuffCategory>
        <traufe>AR_EaveStony</traufe>
        <eckeAussen>AR_StonyEaveOuterCorner</eckeAussen>
        <eckeInnen>AR_StonyEaveInnerCornerSmall</eckeInnen>
        <stuffChain>
          <li>SameAsWall</li>
          <li>BlocksGranite</li>
        </stuffChain>
      </li>

      <li>
        <traufe>AR_Eave</traufe>
        <eckeAussen>AR_EaveCorner</eckeAussen>
        <eckeInnen>AR_EaveInnerCorner</eckeInnen>
        <stuffChain>
          <li>SameAsWall</li>
          <li>WoodLog</li>
        </stuffChain>
      </li>

    </regeln>
  </CustomBaseFramework.TraufenDef>

</Defs>
