      <li>
        <role>FURNITURE_TABLE</role>
        <chain><li>Table2x2c</li></chain>
        <stuffChain><li>WoodLog</li><li>MapWood</li></stuffChain>
      </li>
      <li>
        <role>FURNITURE_BED</role>
        <chain><li>Bed</li></chain>
        <stuffChain><li>WoodLog</li><li>MapWood</li></stuffChain>
      </li>

    </roles>
