      <li>
        <role>WALL</role>
        <criticality>Critical</criticality>
        <chain><li>Wall</li></chain>
        <stuffChain><li>WoodLog</li><li>MapWood</li></stuffChain>
        <tagSearch>AnyWall</tagSearch>
      </li>
      <li>
        <role>FLOOR_INTERIOR</role>
        <criticality>Critical</criticality>
        <terrainChain><li>WoodPlankFloor</li><li>StrawMatting</li></terrainChain>
        <tagSearch>AnyHardFloor</tagSearch>
      </li>
      <li>
        <role>FLOOR_ROAD</role>
