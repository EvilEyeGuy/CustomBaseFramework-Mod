      <li>
        <role>FLOOR_INTERIOR</role>
        <criticality>Critical</criticality>
        <terrainChain><li>WoodPlankFloor</li><li>Concrete</li></terrainChain>
        <tagSearch>AnyHardFloor</tagSearch>
      </li>
      <li>
        <role>FLOOR_FINE</role>
        <terrainChain><li>FlagstoneGranite</li><li>TileSandstone</li><li>Concrete</li></terrainChain>
        <tagSearch>AnyHardFloor</tagSearch>
