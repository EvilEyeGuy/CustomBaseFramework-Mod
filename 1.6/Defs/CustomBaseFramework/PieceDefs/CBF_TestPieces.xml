<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Vorratsschuppen. Zeigt eine Inhaltszone, die fast den ganzen Raum
       einnimmt, und einen Tag ohne Landmarke. -->
  <CustomBaseFramework.PieceDef>
    <defName>CBF_TestShed</defName>
    <schemaVersion>2</schemaVersion>
    <label>Testschuppen</label>
    <categories>
      <li>Storage</li>
    </categories>
    <style>Rustical</style>
    <sockets>
      <li><edge>South</edge><type>RoadFront</type></li>
    </sockets>

    <legend>
      <li><symbol>W</symbol><role>WALL</role></li>
      <li><symbol>D</symbol><role>DOOR</role></li>
      <li><symbol>f</symbol><role>FLOOR_ROUGH</role></li>
      <li><symbol>R</symbol><role>ROOF</role></li>
    </legend>

    <contentZones>
      <li><symbol>V</symbol><category>CBF_Cat_Vorrat</category><count>2~4</count><chance>1.0</chance><lootTable>CBF_Loot_Werkstatt</lootTable></li>
    </contentZones>

    <mask>
      <li>######</li>
      <li>######</li>
      <li>######</li>
      <li>######</li>
      <li>######</li>
    </mask>

    <terrain>
      <li>ffffff</li>
      <li>ffffff</li>
      <li>ffffff</li>
      <li>ffffff</li>
      <li>ffffff</li>
    </terrain>

    <things>
      <li>WWWWWW</li>
      <li>W....W</li>
      <li>W....W</li>
      <li>W....W</li>
      <li>WWDWWW</li>
    </things>

    <content>
      <li>......</li>
      <li>.VVVV.</li>
      <li>.VVVV.</li>
      <li>.VVVV.</li>
      <li>......</li>
    </content>

    <roof>
      <li>RRRRRR</li>
      <li>RRRRRR</li>
      <li>RRRRRR</li>
      <li>RRRRRR</li>
      <li>RRRRRR</li>
    </roof>
  </CustomBaseFramework.PieceDef>

  <!-- Brunnen. Ohne Tuer, damit der Rueckfall auf Umrissanker geprueft wird.
       Landmarke, kommt also vor allen anderen an die Reihe. -->
  <CustomBaseFramework.PieceDef>
    <defName>CBF_TestWell</defName>
    <schemaVersion>2</schemaVersion>
    <label>Testbrunnen</label>
    <categories>
      <li>Landmark</li>
    </categories>
    <style>Rustical</style>
    <allowRotation>false</allowRotation>

    <legend>
      <li><symbol>s</symbol><role>FLOOR_FINE</role></li>
      <li><symbol>P</symbol><role>PILLAR</role></li>
    </legend>

    <mask>
      <li>####</li>
      <li>####</li>
      <li>####</li>
      <li>####</li>
    </mask>

    <terrain>
      <li>ssss</li>
      <li>ssss</li>
      <li>ssss</li>
      <li>ssss</li>
    </terrain>

    <things>
      <li>....</li>
      <li>.PP.</li>
      <li>.PP.</li>
      <li>....</li>
    </things>
  </CustomBaseFramework.PieceDef>

</Defs>
