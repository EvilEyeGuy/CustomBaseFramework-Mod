<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Laengliche Testbausteine. Sie zeigen, dass der Generator nicht nur
       Quadrate setzt, und sie pruefen die Drehung: alle drei sind nicht
       quadratisch, ein Drehfehler faellt sofort auf. -->

  <CustomBaseFramework.PieceDef>
    <defName>CBF_TestStable</defName>
    <schemaVersion>2</schemaVersion>
    <label>Teststall</label>
    <categories>
      <li>Stable</li>
    </categories>
    <style>Rustical</style>
    <allowRotation>true</allowRotation>
    <sockets>
      <li><edge>South</edge><type>RoadFront</type></li>
    </sockets>

    <legend>
      <li><symbol>W</symbol><role>WALL</role></li>
      <li><symbol>D</symbol><role>DOOR</role></li>
      <li><symbol>f</symbol><role>FLOOR_INTERIOR</role></li>
      <li><symbol>r</symbol><role>FLOOR_ROUGH</role></li>
      <li><symbol>p</symbol><role>FLOOR_ROAD</role></li>
      <li><symbol>R</symbol><role>ROOF</role></li>
      <li><symbol>t</symbol><role>FURNITURE_TABLE</role></li>
      <li><symbol>b</symbol><role>FURNITURE_BED</role></li>
      <li><symbol>l</symbol><role>LIGHT</role><chance>0.8</chance></li>
    </legend>

    <contentZones>
      <li><symbol>V</symbol><category>CBF_Cat_Vorrat</category><count>1~2</count><chance>0.6</chance></li>
    </contentZones>

    <mask>
      <li>###########</li>
      <li>###########</li>
      <li>###########</li>
      <li>###########</li>
      <li>###########</li>
      <li>.....#.....</li>
    </mask>

    <terrain>
      <li>rrrrrrrrrrr</li>
      <li>rrrrrrrrrrr</li>
      <li>rrrrrrrrrrr</li>
      <li>rrrrrrrrrrr</li>
      <li>rrrrrrrrrrr</li>
      <li>.....p.....</li>
    </terrain>

    <things>
      <li>WWWWWWWWWWW</li>
      <li>W.........W</li>
      <li>W.........W</li>
      <li>W.........W</li>
      <li>WWWWWDWWWWW</li>
      <li>...........</li>
    </things>

    <content>
      <li>...........</li>
      <li>..VV....VV.</li>
      <li>..VV....VV.</li>
      <li>...........</li>
      <li>...........</li>
      <li>...........</li>
    </content>

    <roof>
      <li>RRRRRRRRRRR</li>
      <li>RRRRRRRRRRR</li>
      <li>RRRRRRRRRRR</li>
      <li>RRRRRRRRRRR</li>
      <li>RRRRRRRRRRR</li>
      <li>...........</li>
    </roof>

  </CustomBaseFramework.PieceDef>

</Defs>
