<Defs>

  <CustomBaseFramework.SettlementPlanDef>
    <defName>CBF_Plan_Lager_Vanilla_Banditen</defName>
    <label>bandit camp</label>
    <materialList>CBF_Modern_Materialliste</materialList>
    <kind>Lager</kind>
    <styles>
      <li>CBF_ModernVanilla</li>
    </styles>
    <coreSize>36~46</coreSize>
    <mapSize>200</mapSize>
    <roadMain>1</roadMain>
    <roadLane>1</roadLane>
    <minBuildingGap>2</minBuildingGap>
    <maxBuildingGap>4</maxBuildingGap>
    <targetBuilt>0.3</targetBuilt>
    <baumanteil>0.15</baumanteil>
    <defenderPoints>150~300</defenderPoints>
    <wards>
      <li>
        <art>Stadt</art>
        <name>Lager</name>
        <versorgung>1.2</versorgung>
        <walls>
          <li><piece>CBF_Vanilla_Linie_Sandsack</piece><weight>0.6</weight></li>
          <li><piece>CBF_Vanilla_Linie_Barrikade</piece><weight>0.4</weight></li>
        </walls>
        <garrison>
          <li><list>CBF_Modern_Garnison_Innen</list><posten>Innen</posten><count>3~5</count></li>
        </garrison>
        <districts>
          <li>
            <name>Lager</name>
            <entries>
              <li><tag>CBF_Vanilla_Anfuehrerzelt</tag><count>1~1</count><unique>true</unique></li>
              <li><tag>CBF_Vanilla_Beuteplatz</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Posten_Sammelplatz</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Schlafzelt</tag><count>3~7</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Umland</art>
        <name>Umland</name>
        <versorgung>1.2</versorgung>
        <districts>
          <li>
            <name>Umland</name>
            <entries>
              <li><tag>CBF_Vanilla_Defense_Small</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
    <lagerArten>
      <li>BanditCamp</li>
    </lagerArten>
    <anteil>0</anteil>
    <ideologieStil>true</ideologieStil>
    <fuerAlleFraktionen>true</fuerAlleFraktionen>
    <techLevels>
      <li>Industrial</li>
      <li>Spacer</li>
      <li>Ultra</li>
    </techLevels>
    <worldTexture>World/WorldObjects/CBF/CBF_Camp</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>

