<Defs>

  <CustomBaseFramework.SettlementPlanDef>
    <defName>CBF_Plan_Camp_Vanilla_Bandits</defName>
    <label>bandit camp</label>
    <materialList>CBF_Modern_MaterialList</materialList>
    <kind>Camp</kind>
    <styles>
      <li>CBF_ModernVanilla</li>
    </styles>
    <coreSize>36~46</coreSize>
    <mapSize>200</mapSize>
    <roadMain>1</roadMain>
    <roadLane>1</roadLane>
    <minBuildingGap>2</minBuildingGap>
    <maxBuildingGap>4</maxBuildingGap>
    <targetBuilt>0.3</targetBuilt>
    <treeShare>0.15</treeShare>
    <defenderPoints>150~300</defenderPoints>
    <wards>
      <li>
        <kind>Town</kind>
        <name>Lager</name>
        <supply>1.2</supply>
        <walls>
          <li><piece>CBF_Vanilla_Line_Sandbag</piece><weight>0.6</weight></li>
          <li><piece>CBF_Vanilla_Line_Barricade</piece><weight>0.4</weight></li>
        </walls>
        <garrison>
          <li><list>CBF_Modern_Garrison_Inside</list><post>Inside</post><count>3~5</count></li>
        </garrison>
        <districts>
          <li>
            <name>Lager</name>
            <entries>
              <li><tag>CBF_Vanilla_LeaderTent</tag><count>1~1</count><unique>true</unique></li>
              <li><tag>CBF_Vanilla_LootSpot</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Outpost_GatheringSpot</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_SleepingTent</tag><count>3~7</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Umland</name>
        <supply>1.2</supply>
        <districts>
          <li>
            <name>Umland</name>
            <entries>
              <li><tag>CBF_Vanilla_Defense_Small</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
    <campTypes>
      <li>BanditCamp</li>
    </campTypes>
    <share>0</share>
    <ideoStyle>true</ideoStyle>
    <forAllFactions>true</forAllFactions>
    <techLevels>
      <li>Industrial</li>
      <li>Spacer</li>
      <li>Ultra</li>
    </techLevels>
    <worldTexture>World/WorldObjects/CBF/CBF_Camp</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>

