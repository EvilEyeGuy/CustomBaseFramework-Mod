  <CustomBaseFramework.SettlementPlanDef>
    <defName>CBF_Plan_Modernestadt</defName>
    <label>Moderne Stadt (Vanilla)</label>
    <kind>Modernestadt</kind>
    <styles>
      <li>CBF_ModernVanilla</li>
      <li>Modern</li>
    </styles>
    <coreSize>86~98</coreSize>
    <mapSize>225</mapSize>
    <wallDepth>0</wallDepth>
    <gates>0~0</gates>
    <roadMain>6</roadMain>
    <roadLane>4</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <gelaendeOeffnen>true</gelaendeOeffnen>
    <wards>
      <li>
        <art>Stadt</art>
        <name>Altstadt</name>
        <label>Zentrum</label>
        <size>1</size>
        <wallDepth>0</wallDepth>
        <gates>0~0</gates>
        <versorgung>1.2</versorgung>
        <roads>
          <li>Concrete</li>
        </roads>
        <roadEdges>
          <li>PavedTile</li>
        </roadEdges>
        <emplacements>
          <li>CBF_ModernDefense</li>
        </emplacements>
        <districts>
          <li>
            <name>Zentrum</name>
            <entries>
              <li><tag>ModernHouseLarge</tag><count>14~22</count></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Vorstadt</art>
        <name>Neustadt</name>
        <label>Wohnviertel</label>
        <size>0.65</size>
        <wallDepth>0</wallDepth>
        <gates>0~0</gates>
        <versorgung>1.2</versorgung>
        <roads>
          <li>Concrete</li>
        </roads>
        <roadEdges>
          <li>PavedTile</li>
        </roadEdges>
        <districts>
          <li>
            <name>Wohnviertel</name>
            <entries>
              <li><piece>CBF_Modern_House</piece><count>14~22</count></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Umland</art>
        <name>Umland</name>
        <size>1.8</size>
        <wallDepth>0</wallDepth>
        <gates>0~0</gates>
        <versorgung>1.2</versorgung><fields><li>
            <name>Acker</name>
            <count>2~2</count>
            <fence>true</fence>
            <weight>1</weight><plants>
              <li>Plant_Rice</li>
             </plants>
            <tags>
              <li>CBF_ModernFarmHouse</li>
            </tags></li></fields>
        <roads>
          <li>Concrete</li>
        </roads>
        <districts>
          <li>
            <name>Umland</name>
            <entries>
              <li><piece>CBF_Modern_Farmhouse</piece><count>2~2</count></li>
              <li><piece>CBF_Modern_Defense</piece><count>3~4</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
  
    <anteil>0</anteil>
