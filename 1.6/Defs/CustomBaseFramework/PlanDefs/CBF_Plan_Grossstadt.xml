<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.SettlementPlanDef MayRequire="DankPyon.Medieval.Overhaul">
    <defName>CBF_Plan_Grossstadt</defName>
    <label>large town</label>
    <kind>Modernestadt</kind>
    <styles>
      <li>CBF_ModernVanilla</li>
    </styles>
    <coreSize>100~112</coreSize>
    <mapSize>225</mapSize>
    <wallDepth>0</wallDepth>
    <roadMain>6</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>0</minBuildingGap>
    <gelaendeOeffnen>true</gelaendeOeffnen>
    <wards>
      <li>
        <art>Stadt</art>
        <name>Altstadt</name>
        <label>Zentrum</label>
        <size>1</size>
        <wallDepth>0</wallDepth>
        <versorgung>1.2</versorgung>
        <roads>
          <li>Concrete</li>
        </roads>
        <roadEdges>
          <li>PavedTile</li>
        </roadEdges>
        <garrison>
          <li>
            <list>CBF_Vanilla_Garrison</list>
            <count>10~20</count>
            <posten>Innen</posten>
          </li>
        </garrison>
        <districts>
          <li>
            <name>Zentrum</name>
            <entries>
              <li><tag>CBF_Vanilla_HouseSmall</tag><count>12~44</count><filler>true</filler></li>
              <li><tag>CBF_Vanilla_Workshop</tag><count>2~12</count><filler>true</filler></li>
              <li><tag>CBF_Vanilla_Gasthaus</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Kirche</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_EnergyProduction</tag><count>4~5</count></li>
              <li><tag>CBF_Vanilla_EnergyStorage</tag><count>1~2</count></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Vorstadt</art>
        <name>Neustadt</name>
        <label>Wohnviertel</label>
        <size>0.65</size>
        <wallDepth>0</wallDepth>
        <versorgung>1.2</versorgung>
        <roads>
          <li>Concrete</li>
        </roads>
        <roadEdges>
          <li>PavedTile</li>
        </roadEdges>
        <garrison>
          <li>
            <list>CBF_Vanilla_Garrison</list>
            <count>5~10</count>
            <posten>Innen</posten>
          </li>
        </garrison>
        <districts>
          <li>
            <name>Wohnviertel</name>
            <entries>
              <li><tag>CBF_Vanilla_HouseLarge</tag><count>12~56</count><filler>true</filler></li>
              <li><tag>CBF_ModernDefense</tag><count>0~4</count></li>
              <li><tag>CBF_Vanilla_EnergyProduction</tag><count>3~5</count></li>
              <li><tag>CBF_Vanilla_Solarpark</tag><count>0~2</count></li>
              <li><tag>CBF_Vanilla_Lager</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Hydrokultur</tag><count>0~2</count></li>
              <li><tag>CBF_Vanilla_Handelsposten</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Kaserne</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Waffenkammer</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Gefaengnis</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Defense_Small</tag><count>4~8</count></li>
              <li><tag>CBF_Vanilla_EnergyStorage</tag><count>3~4</count></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Umland</art>
        <name>Umland</name>
        <size>1.8</size>
        <wallDepth>0</wallDepth>
        <versorgung>1.2</versorgung><fields><li>
            <name>Acker</name>
            <count>3~4</count>
            <fence>false</fence>
            <weight>1</weight><plants>
              <li>Plant_Rice</li>
             </plants>
            <tags>
              <li>CBF_ModernFarmHouse</li>
            </tags></li></fields>
        <roads>
          <li>Concrete</li>
        </roads>
        <districts>
          <li>
            <name>Umland</name>
            <entries>
              <li><tag>CBF_Vanilla_Windpark</tag><count>2~6</count></li>
              <li><tag>CBF_Vanilla_Friedhof</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Defence_Large</tag><count>2~8</count></li>
            </entries>
          </li>
          <li>
            <name>Farming</name><fields><li>
              <name>Acker</name>
              <count>2~4</count>
              <fence>false</fence>
              <weight>1</weight><plants>
