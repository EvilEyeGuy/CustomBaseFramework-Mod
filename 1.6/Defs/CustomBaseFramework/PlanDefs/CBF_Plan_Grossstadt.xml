                <li>Plant_Healroot</li>
               </plants>
              <tags>
                <li>CBF_ModernFarmHouse</li>
              </tags></li></fields>
            <entries>
              <li><piece>CBF_Modern_Farmhouse</piece><count>3~8</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
  
    <anteil>0</anteil>
  
    <techLevels>
      <li>Industrial</li>
    </techLevels>
  
    <fuerAlleFraktionen>true</fuerAlleFraktionen>
  
    <worldTexture>World/WorldObjects/CBF/CBF_City</worldTexture>
