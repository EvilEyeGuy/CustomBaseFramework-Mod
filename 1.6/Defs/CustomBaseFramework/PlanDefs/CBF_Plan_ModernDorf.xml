<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.SettlementPlanDef>
    <defName>CBF_Plan_ModernDorf</defName>
    <materialList>CBF_Modern_Materialliste</materialList>
    <label>modern village (industrial)</label>
    <kind>Modernestadt</kind>
    <styles>
      <li>CBF_ModernVanilla</li>
    </styles>
    <coreSize>56~66</coreSize>
    <mapSize>200</mapSize>
    <roadMain>4</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <gelaendeOeffnen>true</gelaendeOeffnen>
    <wards>
      <li>
        <art>Stadt</art>
        <name>Altstadt</name>
        <label>Dorfkern</label>
        <versorgung>1.2</versorgung>
        <roads>
          <li>Concrete</li>
        </roads>
        <roadEdges>
          <li>PavedTile</li>
        </roadEdges>
        <garrison>
          <li>
            <list>CBF_Modern_Garnison_Innen</list>
            <count>6~9</count>
            <posten>Innen</posten>
          </li>
        </garrison>
        <defenses>
          <li><tag>CBF_Vanilla_Defense_Small</tag><count>2~3</count></li>
        </defenses>
        <districts>
          <li>
            <name>Dorfkern</name>
            <entries>
              <li><tag>CBF_Vanilla_HouseSmall</tag><count>8~16</count><filler>true</filler></li>
              <li><tag>CBF_Vanilla_HouseLarge</tag><count>2~6</count><filler>true</filler></li>
              <li><tag>CBF_Vanilla_Workshop</tag><count>1~3</count></li>
              <li><tag>CBF_Vanilla_Lager</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Gasthaus</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Kirche</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_EnergyProduction</tag><count>1~2</count></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Umland</art>
        <name>Umland</name>
        <versorgung>1.2</versorgung>
        <roads>
          <li>Concrete</li>
        </roads>
        <garrison>
          <li>
            <list>CBF_Modern_Garnison_Innen</list>
            <count>1~3</count>
            <posten>Innen</posten>
          </li>
        </garrison>
        <districts>
          <li>
            <name>Umland</name>
            <entries>
              <li><tag>CBF_Vanilla_Friedhof</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Solarpark</tag><count>0~1</count></li>
            </entries>
          </li>
          <li>
            <name>Farming</name><fields><li>
              <count>2~3</count>
              <fence>false</fence>
              <weight>1</weight><plants>
                <li>Plant_Rice</li>
                <li>Plant_Corn</li>
                <li>Plant_Potato</li>
               </plants>
              <tags>
                <li>CBF_ModernFarmHouse</li>
              </tags></li></fields>
            <entries>
              <li><piece>CBF_Modern_Farmhouse</piece><count>2~4</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>

    <anteil>0</anteil>

    <techLevels>
      <li>Industrial</li>
      <li>Spacer</li>
      <li>Ultra</li>
    </techLevels>

    <ideologieStil>true</ideologieStil>

    <fuerAlleFraktionen>true</fuerAlleFraktionen>

    <worldTexture>World/WorldObjects/CBF/CBF_ModernVillage</worldTexture>
    <wdStufe>1</wdStufe>
  </CustomBaseFramework.SettlementPlanDef>

</Defs>
