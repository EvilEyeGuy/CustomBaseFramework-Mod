<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.SettlementPlanDef>
    <defName>CBF_Plan_ModernVillage</defName>
    <materialList>CBF_Modern_MaterialList</materialList>
    <label>modern village (industrial)</label>
    <kind>ModernTown</kind>
    <styles>
      <li>CBF_ModernVanilla</li>
    </styles>
    <coreSize>56~66</coreSize>
    <mapSize>200</mapSize>
    <roadMain>4</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <openTerrain>true</openTerrain>
    <wards>
      <li>
        <kind>Town</kind>
        <name>OldTown</name>
        <label>Village center</label>
        <supply>1.2</supply>
        <roads>
          <li>Concrete</li>
        </roads>
        <roadEdges>
          <li>PavedTile</li>
        </roadEdges>
        <garrison>
          <li>
            <list>CBF_Modern_Garrison_Inside</list>
            <count>6~9</count>
            <post>Inside</post>
          </li>
        </garrison>
        <defenses>
          <li><tag>CBF_Vanilla_Defense_Small</tag><count>2~3</count></li>
        </defenses>
        <districts>
          <li>
            <name>VillageCore</name>
            <entries>
              <li><tag>CBF_Vanilla_HouseSmall</tag><count>8~16</count><filler>true</filler></li>
              <li><tag>CBF_Vanilla_HouseLarge</tag><count>2~6</count><filler>true</filler></li>
              <li><tag>CBF_Vanilla_Workshop</tag><count>1~3</count></li>
              <li><tag>CBF_Vanilla_Storage</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Tavern</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_GameHall</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_Church</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_EnergyProduction</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_Outpost_Study</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_TownHouse</tag><count>0~2</count></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Countryside</name>
        <supply>1.2</supply>
        <roads>
          <li>Concrete</li>
        </roads>
        <garrison>
          <li>
            <list>CBF_Modern_Garrison_Inside</list>
            <count>1~3</count>
            <post>Inside</post>
          </li>
        </garrison>
        <districts>
          <li>
            <name>Countryside</name>
            <entries>
              <li><tag>CBF_Vanilla_Graveyard</tag><count>0~1</count></li>
              <li><tag>CBF_Vanilla_SolarPark</tag><count>0~1</count></li>
            </entries>
          </li>
          <li>
            <name>Farming</name><fields><li>
              <count>2~3</count>
              <fence>false</fence>
              <weight>1</weight><plants>
                <li>Plant_Rice</li>
                <li>Plant_Corn</li>
                <li>Plant_Potato</li>
               </plants>
              <tags>
                <li>CBF_ModernFarmHouse</li>
              </tags></li></fields>
            <entries>
              <li><piece>CBF_Modern_Farmhouse</piece><count>2~4</count></li>
              <li><tag>CBF_Vanilla_FarmhouseA</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>

    <share>0</share>

    <techLevels>
      <li>Industrial</li>
      <li>Spacer</li>
      <li>Ultra</li>
    </techLevels>

    <ideoStyle>true</ideoStyle>

    <forAllFactions>true</forAllFactions>

    <worldTexture>World/WorldObjects/CBF/CBF_ModernVillage</worldTexture>
    <wdLevel>1</wdLevel>
  </CustomBaseFramework.SettlementPlanDef>

</Defs>
