<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="CBF_BeutebehaelterBase" Abstract="True">
    <thingClass>CustomBaseFramework.Building_LootContainer</thingClass>
    <category>Building</category>
    <selectable>true</selectable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <useHitPoints>true</useHitPoints>
    <tickerType>Never</tickerType>
    <castEdgeShadows>true</castEdgeShadows>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <blockWind>false</blockWind>
    <canOverlapZones>false</canOverlapZones>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <WorkToBuild>500</WorkToBuild>
      <Mass>10</Mass>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>true</deconstructible>
      <claimable>true</claimable>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
    <inspectorTabs>
      <li>ITab_ContentsCasket</li>
    </inspectorTabs>
  </ThingDef>





  <ThingDef ParentName="CBF_BeutebehaelterBase">
    <defName>CBF_Sarcophagus</defName>
    <label>sarcophagus</label>
    <description>An ornamented burial receptacle from a forgotten age.</description>
    <graphicData>
      <texPath>Things/Building/Misc/SarcophagusFull</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <size>(1,2)</size>
    <pathCost>42</pathCost>
    <fillPercent>0.5</fillPercent>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>40</Mass>
    </statBases>
    <modExtensions>
      <li Class="CustomBaseFramework.LootContainerExtension">
        <emptyGraphic>
          <texPath>Things/Building/Misc/Sarcophagus</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(3,4)</drawSize>
        </emptyGraphic>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
