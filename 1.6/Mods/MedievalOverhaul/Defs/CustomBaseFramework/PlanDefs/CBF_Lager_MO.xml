          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Umland</name>
        <supply>1.2</supply>
        <districts>
          <li>
            <name>Umland</name>
            <entries>
              <li><tag>CBF_MO_HorseStall</tag><count>0~1</count></li>
            </entries>
          </li>
