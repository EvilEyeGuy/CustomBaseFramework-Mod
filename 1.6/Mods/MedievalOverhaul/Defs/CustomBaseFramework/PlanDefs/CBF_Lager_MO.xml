<Defs>

  <CustomBaseFramework.SettlementPlanDef MayRequire="DankPyon.Medieval.Overhaul">
    <defName>CBF_Plan_Lager_MO_Banditen</defName>
    <label>bandit camp (MO)</label>
    <materialList>CBF_MO_Materialliste</materialList>
    <kind>Lager</kind>
    <styles>
      <li>Rustical</li>
    </styles>
    <coreSize>36~46</coreSize>
    <mapSize>200</mapSize>
    <roadMain>1</roadMain>
    <roadLane>1</roadLane>
    <minBuildingGap>2</minBuildingGap>
    <maxBuildingGap>4</maxBuildingGap>
    <targetBuilt>0.3</targetBuilt>
    <baumanteil>0.15</baumanteil>
    <defenderPoints>150~300</defenderPoints>
    <wards>
      <li>
        <art>Stadt</art>
        <name>Lager</name>
        <versorgung>1.2</versorgung>
        <walls>
          <li><piece>CBF_MO_Pfahlwall</piece><weight>0.4</weight></li>
          <li><piece>CBF_MO_Barrikadenwall</piece><weight>0.3</weight></li>
          <li><piece>Palisade</piece><weight>0.3</weight></li>
        </walls>
        <garrison>
          <li><list>CBF_MO_Garnison_Innen</list><posten>Innen</posten><count>3~5</count></li>
        </garrison>
        <districts>
          <li>
            <name>Lager</name>
            <entries>
              <li><tag>CBF_MO_Kommandozelt</tag><count>1~1</count><unique>true</unique></li>
              <li><tag>CBF_MO_Waffenzelt</tag><count>1~2</count></li>
              <li><tag>CBF_MO_Beuteplatz</tag><count>1~2</count></li>
              <li><tag>CBF_MO_Lagerfeuer</tag><count>1~1</count></li>
              <li><tag>CBF_MO_Soldatenzelt</tag><count>3~7</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Umland</art>
        <name>Umland</name>
        <versorgung>1.2</versorgung>
        <districts>
          <li>
            <name>Umland</name>
            <entries>
              <li><tag>CBF_MO_Pferdestand</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
    <lagerArten>
      <li>BanditCamp</li>
    </lagerArten>
    <anteil>0</anteil>
    <fuerAlleFraktionen>true</fuerAlleFraktionen>
    <techLevels>
      <li>Medieval</li>
    </techLevels>
    <worldTexture>World/WorldObjects/CBF/CBF_CampPalisade</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>

