        <garrison>
          <li><list>CBF_MO_Garrison_Inside</list><post>Inside</post><count>3~5</count></li>
        </garrison>
        <districts>
          <li>
            <name>Lager</name>
            <entries>
              <li><tag>CBF_MO_CommandTent</tag><count>1~1</count><unique>true</unique></li>
              <li><tag>CBF_MO_WeaponTent</tag><count>1~2</count></li>
