              <li><tag>CBF_MO_CookHut</tag><count>1~1</count></li>
              <li><tag>CBF_MO_Campfire</tag><count>0~1</count></li>
              <li><tag>CBF_MO_SoldierTent</tag><count>3~7</count><filler>true</filler></li>
