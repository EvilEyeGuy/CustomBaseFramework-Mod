<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.SettlementPlanDef MayRequire="DankPyon.Medieval.Overhaul">
    <defName>CBF_Plan_FortressCity</defName>
    <label>Fortress City</label>

    <styles>
      <li>Rustical</li>
      <li>Standard</li>
    </styles>

    <coreSize>100~115</coreSize>
    <mapSize>200</mapSize>

    <wallDepth>3</wallDepth>
    <towerCorner>7</towerCorner>
    <towerCurtain>7</towerCurtain>
    <towerCapTotal>0</towerCapTotal>
    <wallGap>1</wallGap>

    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <widenings>0</widenings>
    <minBuildingGap>1</minBuildingGap>
    <maxBuildingGap>4</maxBuildingGap>
    <targetBuilt>0.55</targetBuilt>
    <coverageBuild>0.42</coverageBuild>
    <weightNearRoad>1.4</weightNearRoad>
    <gardenShare>0</gardenShare>
    <defenderPoints>260~480</defenderPoints>
    <defendersOnWall>0.28</defendersOnWall>

  
    <wards>
      <li>
        <art>Stadt</art>
        <name>Altstadt</name>
        <size>1</size>
        <wallDepth>3</wallDepth>
        <versorgung>1.2</versorgung>
        <walls>
          <li>TownWall_1x5</li>
        </walls>
        <emplacements>
          <li>LargeTower_9d</li>
          <li>LargeTower_9d_B</li>
        </emplacements>
        <gatehouses>
          <li><piece>GateHouse</piece><count>1~2</count></li>
          <li>CBF_MO_GateHouse_Small</li>
        </gatehouses>
        <districts>
          <li>
            <name>Default</name>
            <entries>
              <li><tag>Keep</tag><count>1~3</count><unique>true</unique><lootTable>CBF_MO_Loot_Bergfried</lootTable></li>
              <li><tag>Inn</tag><count>1~1</count><unique>true</unique><lootTable>CBF_MO_Loot_Gasthaus</lootTable></li>
              <li><tag>Military</tag><count>2~6</count><lootTable>CBF_MO_Loot_Waffenkammer</lootTable></li>
              <li><tag>Workshop</tag><count>1~4</count><lootTable>CBF_MO_Loot_Werkstatt</lootTable></li>
              <li><tag>CBF_MO_TudorHouse</tag><count>10~14</count><filler>true</filler></li>
              <li><tag>CBF_MO_MilitaryWallAttachment</tag><count>2~4</count></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Vorstadt</art>
        <name>Neustadt</name>
        <size>0.6</size>
        <wallDepth>1</wallDepth>
        <versorgung>1.2</versorgung>
        <walls>
          <li>TownWall</li>
        </walls>
        <emplacements>
          <li>Tower</li>
        </emplacements>
        <gatehouses>
          <li>GateHouse</li>
        </gatehouses>
        <districts>
          <li>
            <name>Test</name>
            <entries>
              <li><tag>HouseSmall</tag><count>20~28</count><filler>true</filler><lootTable>CBF_MO_Loot_Wohnhaus</lootTable></li>
              <li><piece>Social_Inn</piece><count>1~2</count><lootTable>CBF_MO_Loot_Gasthaus</lootTable></li>
              <li><piece>Military_Baracks</piece><count>3~3</count><lootTable>CBF_MO_Loot_Waffenkammer</lootTable></li>
            </entries>
          </li>
          <li>
            <name>Workshop</name>
            <entries>
              <li><piece>Workshop_Baker</piece><count>1~1</count><lootTable>CBF_MO_Loot_Baeckerei</lootTable></li>
              <li><piece>Workshop_Butcher</piece><count>1~1</count><lootTable>CBF_MO_Loot_Metzgerei</lootTable></li>
              <li><piece>Workshop_Tailor</piece><count>1~1</count><lootTable>CBF_MO_Loot_Schneiderei</lootTable></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Umland</art>
        <name>Umland</name>
        <size>2.2</size>
        <wallDepth>0</wallDepth>
        <versorgung>1.2</versorgung>
        <districts>
          <li>
            <name>Umland</name>
            <entries>
              <li><piece>Social_Inn</piece><count>1~1</count><lootTable>CBF_MO_Loot_Gasthaus</lootTable></li>
            </entries>
          </li>
          <li>
            <name>Farming</name><fields><li>
              <name>Acker</name>
              <count>3~3</count>
              <fence>true</fence>
              <weight>1</weight><plants>
                <li>Plant_Haygrass</li>
               </plants>
              <tags>
                <li>HouseSmall</li>
              </tags></li></fields><pens><li>
              <name>Gehege</name>
              <count>1~1</count>
              <herd>3~7</herd>
              <pawns>CBF_Pawns_Neu3</pawns>
              <fence>true</fence>
              <weight>1</weight></li></pens>
            <entries>
              <li><tag>HouseSmall</tag><count>3~6</count><filler>true</filler><lootTable>CBF_MO_Loot_Wohnhaus</lootTable></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
  
    <kind>Mittelalterstadt</kind>
  
    <factionTags>
      <li>DankPyon_NobleHouseSavage</li>
      <li>DankPyon_NobleHouseFierce</li>
    </factionTags>
  
    <anteil>10</anteil>
    <suburbIslands>2</suburbIslands>
  
    <worldTexture>World/WorldObjects/CBF/CBF_FortressTown</worldTexture>
  
    <techLevels>
      <li>Medieval</li>
    </techLevels>
  </CustomBaseFramework.SettlementPlanDef>

</Defs>