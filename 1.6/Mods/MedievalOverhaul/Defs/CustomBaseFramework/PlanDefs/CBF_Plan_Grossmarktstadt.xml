<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.SettlementPlanDef MayRequire="DankPyon.Medieval.Overhaul">
    <defName>CBF_Plan_Grossmarktstadt</defName>
    <label>Grosse Marktstadt</label>

    <styles>
      <li>Rustical</li>
      <li>Standard</li>
    </styles>

    <coreSize>105~120</coreSize>
    <mapSize>250</mapSize>

    <wallDepth>3</wallDepth>
    <towerCorner>7</towerCorner>
    <towerCurtain>7</towerCurtain>
    <towerCapTotal>0</towerCapTotal>
    <wallGap>1</wallGap>

    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <widenings>0</widenings>
    <minBuildingGap>0</minBuildingGap>
    <maxBuildingGap>4</maxBuildingGap>
    <targetBuilt>0.55</targetBuilt>
    <coverageBuild>0.42</coverageBuild>
    <weightNearRoad>1.4</weightNearRoad>
    <gardenShare>0</gardenShare>
    <defenderPoints>260~480</defenderPoints>
    <defendersOnWall>0.28</defendersOnWall>

  
    <wards>
      <li>
        <art>Stadt</art>
        <name>Altstadt</name>
        <size>1</size>
        <wallDepth>3</wallDepth>
        <versorgung>1.2</versorgung>
        <walls>
          <li>TownWall</li>
        </walls>
        <emplacements>
          <li>LargeTower_9d</li>
          <li>LargeTower_9d_B</li>
        </emplacements>
        <gatehouses>
          <li>CBF_MO_GateHouse_Small</li>
          <li>GateHouse</li>
        </gatehouses>
        <districts>
          <li>
            <name>Default</name>
            <entries>
              <li><tag>Keep</tag><count>1~1</count><unique>true</unique><lootTable>CBF_MO_Loot_Bergfried</lootTable></li>
              <li><tag>Inn</tag><count>1~1</count><unique>true</unique><lootTable>CBF_MO_Loot_Gasthaus</lootTable></li>
              <li><tag>CBF_MO_TudorHouse</tag><count>10~14</count></li>
              <li><tag>CBF_MO_MilitaryWallAttachment</tag><count>1~2</count></li>
              <li><piece>Military_Trebuchets</piece><count>0~2</count></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Vorstadt</art>
        <name>Neustadt</name>
        <size>0.6</size>
        <wallDepth>1</wallDepth>
        <versorgung>1.2</versorgung>
        <walls>
          <li MayRequire="DankPyon.Medieval.Overhaul">Palisade</li>
        </walls>
        <emplacements>
          <li MayRequire="DankPyon.Medieval.Overhaul"><piece>PalisadeTower</piece><count>3~6</count></li>
        </emplacements>
        <gatehouses>
          <li MayRequire="DankPyon.Medieval.Overhaul"><piece>Pallisader_GateHouse</piece><count>1~1</count></li>
        </gatehouses>
        <districts>
          <li>
            <name>Test</name>
            <entries>
              <li><tag>HouseSmall</tag><count>29~50</count><filler>true</filler><lootTable>CBF_MO_Loot_Wohnhaus</lootTable></li>
              <li><piece>Social_Inn</piece><count>1~2</count><lootTable>CBF_MO_Loot_Gasthaus</lootTable></li>
            </entries>
          </li>
          <li>
            <name>Workshop</name>
            <entries>
              <li><piece>Workshop_Baker</piece><count>1~1</count><lootTable>CBF_MO_Loot_Baeckerei</lootTable></li>
              <li><piece>Workshop_Butcher</piece><count>1~1</count><lootTable>CBF_MO_Loot_Metzgerei</lootTable></li>
              <li><piece>Workshop_Tailor</piece><count>1~1</count><lootTable>CBF_MO_Loot_Schneiderei</lootTable></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Umland</art>
        <name>Umland</name>
        <size>2.2</size>
        <wallDepth>0</wallDepth>
        <versorgung>1.2</versorgung>
        <districts>
          <li>
            <name>Umland</name>
            <entries>
              <li><piece>Social_Inn</piece><count>1~1</count><lootTable>CBF_MO_Loot_Gasthaus</lootTable></li>
            </entries>
          </li>
          <li>
            <name>Wheat</name><fields><li>
              <name>Acker</name>
              <count>5~8</count>
              <fence>true</fence>
              <weight>1</weight><plants>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Carrots</li>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Garlic</li>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Onions</li>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Pumpkins</li>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Wheat</li>
                <li>Plant_Corn</li>
               </plants>
              <tags>
                <li>Farm</li>
              </tags></li></fields>
            <entries>
              <li><tag>Farm</tag><count>3~6</count><lootTable>CBF_MO_Loot_Bauernhof</lootTable></li>
            </entries>
          </li>
          <li>
            <name>Cattle</name><pens><li>
              <name>Gehege</name>
              <count>1~1</count>
              <herd>3~7</herd>
              <pawns>Hardanimals_1</pawns>
              <fence>true</fence>
              <terrain>Soil</terrain><plants>
                <li>Plant_Haygrass</li>
               </plants>
              <weight>1</weight></li></pens>
            <entries>
              <li><tag>HouseSmall</tag><count>1~2</count><filler>true</filler><lootTable>CBF_MO_Loot_Wohnhaus</lootTable></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
  
    <kind>Mittelalterstadt</kind>
  
    <factionTags>
      <li>DankPyon_NobleHouseSavage</li>
      <li>DankPyon_NobleHouseFierce</li>
    </factionTags>
  
    <anteil>40</anteil>
    <suburbIslands>2</suburbIslands>
  
    <techLevels>
      <li>Medieval</li>
    </techLevels>
  
    <fuerAlleFraktionen>true</fuerAlleFraktionen>
  
    <worldTexture>World/WorldObjects/CBF/CBF_MarketTownLarge</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>
</Defs>
