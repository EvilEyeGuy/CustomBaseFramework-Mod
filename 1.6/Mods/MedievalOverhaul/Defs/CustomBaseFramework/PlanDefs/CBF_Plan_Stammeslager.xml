<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.SettlementPlanDef MayRequire="DankPyon.Medieval.Overhaul">
    <defName>CBF_Plan_Stammeslager</defName>
    <label>tribal camp (MO)</label>
    <materialList>CBF_MO_Materialliste</materialList>
    <kind>Lager</kind>
    <styles>
      <li>Rustical</li>
    </styles>
    <coreSize>52~64</coreSize>
    <mapSize>200</mapSize>
    <roadMain>1</roadMain>
    <roadLane>1</roadLane>
    <minBuildingGap>2</minBuildingGap>
    <maxBuildingGap>4</maxBuildingGap>
    <targetBuilt>0.32</targetBuilt>
    <baumanteil>0.15</baumanteil>
    <defenderPoints>150~300</defenderPoints>

    <wards>
      <li>
        <art>Stadt</art>
        <name>Lager</name>
        <label>Lager</label>
        <versorgung>1.2</versorgung>
        <walls>
          <li><piece>CBF_MO_Pfahlwall</piece><weight>0.4</weight></li>
          <li><piece>CBF_MO_Barrikadenwall</piece><weight>0.3</weight></li>
          <li><piece>Palisade</piece><weight>0.3</weight></li>
        </walls>
        <garrison>
          <li><list>CBF_MO_Stamm_Wache</list><posten>Innen</posten><count>5~8</count></li>
          <li><list>CBF_MO_Stamm_Posten</list><posten>Tor</posten><count>2~4</count></li>
        </garrison>
        <districts>
          <li>
            <name>Mitte</name>
            <entries>
              <li><tag>CBF_MO_Hauptzelt</tag><count>1~1</count><unique>true</unique></li>
              <li><tag>CBF_MO_Versammlungszelt</tag><count>1~2</count></li>
              <li><tag>CBF_MO_Werkzelt</tag><count>1~3</count></li>
              <li><tag>CBF_MO_Lagerfeuer</tag><count>1~2</count></li>
              <li><tag>CBF_MO_Wohnzelt</tag><count>4~14</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Umland</art>
        <name>Umland</name>
        <versorgung>1.2</versorgung>
        <garrison>
          <li><list>CBF_MO_Stamm_Wache</list><posten>Innen</posten><count>1~3</count></li>
        </garrison>
        <districts>
          <li>
            <name>Rand</name>
            <entries>
              <li><tag>CBF_MO_Zelt</tag><count>0~3</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>

    <anteil>0</anteil>

    <techLevels>
      <li>Neolithic</li>
    </techLevels>

    <fuerAlleFraktionen>true</fuerAlleFraktionen>

    <worldTexture>World/WorldObjects/CBF/CBF_CampPalisade</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>

</Defs>
