<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>CBF_MO_MineSupport</defName>
    <label>mine support</label>
    <description>A wooden frame of two posts and a beam that holds up the rock above a mine tunnel.</description>
    <thingClass>CustomBaseFramework.Building_MineSupport</thingClass>
    <graphicData>
      <texPath>Things/Building/Door/RusticDoor1x2/RusticDoor1x2_Support</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/Door/RusticDoor1x2/RusticDoor1x2_MenuIcon_south</uiIconPath>
    <modExtensions>
      <li Class="CustomBaseFramework.SupportGraphic">
        <top>
          <texPath>Things/Building/Door/RusticDoor1x2/RusticDoor1x2_Top</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(3,2)</drawSize>
        </top>
      </li>
    </modExtensions>
    <size>(2,1)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0.1</fillPercent>
    <blockWind>false</blockWind>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Flammability>1</Flammability>
    </statBases>
    <building>
      <isEdifice>true</isEdifice>
    </building>
  </ThingDef>
</Defs>
