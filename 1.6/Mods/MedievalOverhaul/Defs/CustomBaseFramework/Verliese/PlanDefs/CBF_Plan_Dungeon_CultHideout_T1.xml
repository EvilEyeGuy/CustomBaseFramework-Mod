<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.SettlementPlanDef MayRequire="DankPyon.Medieval.Overhaul">
    <defName>CBF_Plan_Dungeon_CultHideout_T1</defName>
    <defenderPoints>300</defenderPoints>
    <wealthFactor>0.12</wealthFactor>
    <label>cult hideout (tier 1)</label>
    <kind>Dungeon</kind>
    <materialList>CBF_MO_MaterialList</materialList>
    <styles>
      <li>Rustical</li>
      <li>Standard</li>
    </styles>
    <mapSize>200</mapSize>
    <techLevels>
      <li>Medieval</li>
    </techLevels>
    <levels>
      <li>
        <name>Upper</name>
        <label>upper level</label>
        <layouts>
          <li>Corridors</li>
          <li>Rows</li>
          <li>Warren</li>
        </layouts>
        <caveWidth>1~3</caveWidth>
        <caveShare>0.3</caveShare>
        <secretChance>0.1</secretChance>
        <sections>
          <li>
            <name>Front</name>
            <label>front</label>
            <corridors>
              <li><piece>CBF_MO_Dungeon_Corridor_Hewn_3</piece><weight>9</weight></li>
              <li><piece>CBF_MO_Dungeon_Corridor_Hewn_1</piece><weight>1</weight></li>
            </corridors>
            <decor>
              <li>
                <objects>CBF_MO_Mine_Light</objects>
                <spacing>5~8</spacing>
                <weight>2</weight>
              </li>
              <li>
                <objects>CBF_MO_Dungeon_Rubble</objects>
                <spacing>5~8</spacing>
                <weight>1</weight>
              </li>
              <li>
                <objects>CBF_MO_Dungeon_Bones</objects>
                <spacing>5~8</spacing>
                <weight>1</weight>
              </li>
            </decor>
            <districts>
              <li>
                <name>Lair</name>
                <entries>
                  <li><piece>CBF_MO_Dungeon_CultistDormitory_Rundown_A</piece><count>1~1</count></li>
                  <li><tag>CBF_Dungeon_CultistDormitory</tag><count>3~4</count></li>
                  <li><tag>CBF_Dungeon_Storeroom</tag><count>2~3</count></li>
                  <li><tag>CBF_Dungeon_Guardroom</tag><count>2~3</count></li>
                  <li><tag>CBF_Dungeon_Mess</tag><count>1~1</count></li>
                  <li><tag>CBF_Dungeon_Pantry</tag><count>1~1</count></li>
                  <li><tag>CBF_Dungeon_Refectory</tag><count>0~1</count></li>
                  <li><tag>CBF_Dungeon_BenchHall</tag><count>0~1</count></li>
                  <li><tag>CBF_Dungeon_Bunkroom</tag><count>1~2</count></li>
                </entries>
              </li>
            </districts>
          </li>
          <li>
            <name>Back</name>
            <label>back</label>
            <corridors>
              <li><piece>CBF_MO_Dungeon_Corridor_Stone_3</piece><weight>10</weight></li>
              <li><piece>CBF_MO_Dungeon_Corridor_Stone_1</piece><weight>1</weight></li>
            </corridors>
            <decor>
              <li>
                <objects>CBF_MO_Dungeon_WallTorch</objects>
                <spacing>4~7</spacing>
                <weight>1.8</weight>
              </li>
              <li>
                <objects>CBF_MO_Dungeon_Candles</objects>
                <spacing>4~7</spacing>
                <weight>0.9</weight>
              </li>
              <li>
                <objects>CBF_MO_Dungeon_Bones</objects>
                <spacing>4~7</spacing>
                <weight>0.9</weight>
              </li>
            </decor>
            <districts>
              <li>
                <name>Hideout</name>
                <entries>
                  <li><piece>CBF_MO_Dungeon_HideoutT1_Chapel_A</piece><count>1~1</count><priority>Critical</priority></li>
                  <li><tag>CBF_Dungeon_HideoutT1</tag><count>2~3</count></li>
                  <li><tag>CBF_Dungeon_Cells</tag><count>1~2</count></li>
                  <li><tag>CBF_Dungeon_Chapel</tag><count>0~1</count></li>
                  <li><tag>CBF_Dungeon_Archive</tag><count>0~1</count></li>
                </entries>
              </li>
              <li>
                <name>Cave</name>
                <layout>Cave</layout>
                <entries>
                  <li><tag>CBF_Dungeon_CaveFeature</tag><count>2~3</count></li>
                </entries>
              </li>
            </districts>
          </li>
        </sections>
      </li>
    </levels>

    <ideoStyle>true</ideoStyle>
  </CustomBaseFramework.SettlementPlanDef>

</Defs>
