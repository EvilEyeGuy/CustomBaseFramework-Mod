<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.SettlementPlanDef MayRequire="DankPyon.Medieval.Overhaul">
    <defName>CBF_Plan_Dungeon_Ruin_Large</defName>
    <defenderPoints>900</defenderPoints>
    <wealthFactor>0.17</wealthFactor>
    <label>large ruin</label>
    <kind>Dungeon</kind>
    <materialList>CBF_MO_MaterialList</materialList>
    <styles>
      <li>Rustical</li>
      <li>Standard</li>
    </styles>
    <mapSize>160</mapSize>
    <techLevels>
      <li>Medieval</li>
    </techLevels>
    <levels>
      <li>
        <name>Ruin</name>
        <label>ruin</label>
        <layouts>
          <li>Rows</li>
          <li>Grid</li>
          <li>Temple</li>
        </layouts>
        <caveWidth>1~3</caveWidth>
        <caveShare>0.3</caveShare>
        <secretChance>0.1</secretChance>
        <sections>
          <li>
            <name>Front</name>
            <label>camp</label>
            <corridors>
              <li><piece>CBF_MO_Dungeon_Corridor_Hewn_3</piece><weight>9</weight></li>
              <li><piece>CBF_MO_Dungeon_Corridor_Hewn_1</piece><weight>1</weight></li>
            </corridors>
            <decor>
              <li>
                <objects>CBF_MO_Dungeon_Rubble</objects>
                <spacing>3~5</spacing>
                <weight>3</weight>
              </li>
              <li>
                <objects>CBF_MO_Dungeon_Beams</objects>
                <spacing>3~5</spacing>
                <weight>1</weight>
              </li>
              <li>
                <objects>CBF_MO_Mine_Light</objects>
                <spacing>3~5</spacing>
                <weight>1</weight>
              </li>
            </decor>
            <districts>
              <li>
                <name>Camp</name>
                <entries>
                  <li><tag>CBF_Dungeon_Bunkroom</tag><count>2~3</count></li>
                  <li><tag>CBF_Dungeon_Guardroom</tag><count>2~3</count></li>
                  <li><tag>CBF_Dungeon_Storeroom</tag><count>2~3</count></li>
                  <li><tag>CBF_Dungeon_Mess</tag><count>1~1</count></li>
                  <li><tag>CBF_Dungeon_Pantry</tag><count>1~1</count></li>
                  <li><tag>CBF_Dungeon_BenchHall</tag><count>0~1</count></li>
                  <li><tag>CBF_Dungeon_WellRoom</tag><count>0~1</count></li>
                  <li><tag>CBF_Dungeon_Cells</tag><count>0~1</count></li>
                </entries>
              </li>
              <li>
                <name>Cave</name>
                <layout>Cave</layout>
                <entries>
                  <li><tag>CBF_Dungeon_GuardPost</tag><count>1~2</count></li>
                </entries>
              </li>
            </districts>
          </li>
          <li>
            <name>Back</name>
            <label>old halls</label>
            <corridors>
              <li><piece>CBF_MO_Dungeon_Corridor_Masonry_3</piece><weight>7</weight></li>
              <li><piece>CBF_MO_Dungeon_Corridor_Masonry_1</piece><weight>1</weight></li>
            </corridors>
            <decor>
              <li>
                <objects>CBF_MO_Dungeon_Bones</objects>
                <spacing>4~7</spacing>
                <weight>2.5</weight>
              </li>
              <li>
                <objects>CBF_MO_Dungeon_WallTorch</objects>
                <spacing>4~7</spacing>
                <weight>1.2</weight>
              </li>
            </decor>
            <districts>
              <li>
                <name>Halls</name>
                <entries>
                  <li><tag>CBF_Dungeon_StatueHall</tag><count>1~1</count></li>
                  <li><tag>CBF_Dungeon_TrophyHall</tag><count>0~1</count></li>
                  <li><tag>CBF_Dungeon_Tomb</tag><count>1~2</count></li>
                  <li><tag>CBF_Dungeon_BurialChamber</tag><count>0~1</count></li>
                  <li><tag>CBF_Dungeon_Archive</tag><count>0~1</count></li>
                  <li><tag>CBF_Dungeon_Vault</tag><count>1~1</count></li>
                  <li><tag>CBF_Dungeon_Guardroom</tag><count>1~1</count></li>
                </entries>
              </li>
              <li>
                <name>Cave</name>
                <layout>Cave</layout>
                <entries>
                  <li><tag>CBF_Dungeon_TreasureHeap</tag><count>1~1</count></li>
                </entries>
              </li>
            </districts>
          </li>
        </sections>
      </li>
    </levels>

    <ideoStyle>true</ideoStyle>
  </CustomBaseFramework.SettlementPlanDef>

</Defs>
