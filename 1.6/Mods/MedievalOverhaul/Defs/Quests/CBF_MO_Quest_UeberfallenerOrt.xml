<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <QuestScriptDef>
    <defName>CBF_MO_Quest_UeberfallenerOrt</defName>
    <rootSelectionWeight>1.0</rootSelectionWeight>
    <rootMinPoints>300</rootMinPoints>
    <expireDaysRange>4~8</expireDaysRange>
    <questNameRules>
      <rulesStrings>
        <li>questName->The Raided [place]</li>
        <li>questName->Bandits in [asker_nameDef]'s [place]</li>
        <li>questName->[asker_nameDef] and the Raided [place]</li>
        <li>place->Village</li>
        <li>place->Settlement</li>
        <li>place->Town</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[asker_nameFull], [asker_faction_leaderTitle] of [asker_faction_name], asks for help. [siteFaction_pawnsPlural] of [siteFaction_name] have overrun one of [asker_possessive] settlements. Parts of it are burnt and the walls are breached.\n\n[asker_nameDef] asks us to drive them out. Whatever is left in the settlement will be our reward.\n\nAfter the fight we decide: leave the settlement to [asker_faction_name] for goodwill, or take what the bandits left behind. If the settlement goes back to [asker_faction_name], taking items or claiming buildings there costs goodwill.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
          <parms>
            <pointsFactorTwoStar>1.5</pointsFactorTwoStar>
            <pointsFactorThreeStar>2</pointsFactorThreeStar>
          </parms>
        </li>

        <li Class="QuestNode_SubScript">
          <def>Util_AdjustPointsForDistantFight</def>
        </li>

        <li Class="QuestNode_GetMap" />

        <li Class="CustomBaseFramework.QuestNode_CBFClient">
          <storeAs>asker</storeAs>
          <storeFactionAs>askerFaction</storeFactionAs>
          <sitePart>CBF_MO_Quest_UeberfallenerOrt</sitePart>
        </li>

        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>

        <li Class="CustomBaseFramework.QuestNode_CBFOccupier">
          <storeAs>siteFaction</storeAs>
          <storeSitePartDefsAs>sitePartDefs</storeSitePartDefsAs>
          <sitePart>CBF_MO_Quest_UeberfallenerOrt</sitePart>
          <enemyOf>$askerFaction</enemyOf>
        </li>

        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>

        <li Class="QuestNode_GetSiteThreatPoints">
          <storeAs>sitePoints</storeAs>
          <sitePartsParams>$sitePartsParams</sitePartsParams>
        </li>

        <li Class="QuestNode_Multiply">
          <value1>$sitePoints</value1>
          <value2>1.5</value2>
          <storeAs>besatzungPunkte</storeAs>
        </li>

        <li Class="QuestNode_GenerateSite">
          <sitePartsParams>$sitePartsParams</sitePartsParams>
          <faction>$siteFaction</faction>
          <tile>$siteTile</tile>
          <worldObjectDef>CBF_MO_Quest_UeberfallenerOrt</worldObjectDef>
          <storeAs>site</storeAs>
        </li>

        <li Class="CustomBaseFramework.QuestNode_CBFSite">
          <site>$site</site>
          <builder>$askerFaction</builder>
          <points>$besatzungPunkte</points>
        </li>

        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>

        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>$(randInt(12,28)*60000)</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <destroyOnCleanup>true</destroyOnCleanup>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="CBF_Quest_LetterLabelExpired">Quest expired: [resolvedQuestName]</label>
                <text TKey="CBF_Quest_LetterTextExpired">The bandits have looted the settlement and moved on. The quest [resolvedQuestName] has expired.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_SignalActivable">
          <inSignal>site.Destroyed</inSignal>
          <inSignalDisable>site.AllEnemiesDefeated</inSignalDisable>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="CBF_Quest_LetterLabelFailed">Quest failed: [resolvedQuestName]</label>
                <text TKey="CBF_Quest_LetterTextFailed">We left the settlement before the bandits were driven out. The quest [resolvedQuestName] has ended.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <node Class="QuestNode_Notify_PlayerRaidedSomeone">
            <getRaidersFromMapParent>$site</getRaidersFromMapParent>
          </node>
        </li>

        <li Class="CustomBaseFramework.QuestNode_CBFChoice">
          <inSignalDefeated>site.AllEnemiesDefeated</inSignalDefeated>
          <inSignalGone>site.Destroyed</inSignalGone>
          <outSignalFaction>WahlFraktion</outSignalFaction>
          <outSignalLoot>WahlBeute</outSignalLoot>
          <site>$site</site>
          <faction>$askerFaction</faction>
          <lord>$asker</lord>
          <goodwillFaction>20</goodwillFaction>
          <goodwillLoot>3</goodwillLoot>
        </li>

        <li Class="QuestNode_End">
          <inSignal>WahlFraktion</inSignal>
          <outcome>Success</outcome>
        </li>

        <li Class="QuestNode_End">
          <inSignal>WahlBeute</inSignal>
          <outcome>Success</outcome>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
