<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <QuestScriptDef>
    <defName>CBF_MO_Quest_UmkaempfterOrt</defName>
    <rootSelectionWeight>1.0</rootSelectionWeight>
    <rootMinPoints>300</rootMinPoints>
    <canGiveRoyalFavor>true</canGiveRoyalFavor>
    <expireDaysRange>1~2</expireDaysRange>
    <modExtensions>
      <li Class="CustomBaseFramework.CBFBelohnungExtension">
        <hoechsteTechstufe>Medieval</hoechsteTechstufe>
        <verboteneDinge>
          <li>Plasteel</li>
          <li>Uranium</li>
          <li>Hyperweave</li>
          <li>Synthread</li>
          <li>ComponentIndustrial</li>
          <li>ComponentSpacer</li>
          <li>ReinforcedBarrel</li>
          <li>Chemfuel</li>
          <li>Neutroamine</li>
          <li>Luciferium</li>
          <li>GoJuice</li>
          <li>WakeUp</li>
          <li>Penoxycyline</li>
          <li>MedicineIndustrial</li>
          <li>MedicineUltratech</li>
          <li>AIPersonaCore</li>
          <li>TechprofSubpersonaCore</li>
          <li>OrbitalTargeterBombardment</li>
          <li>OrbitalTargeterPowerBeam</li>
          <li>TornadoGenerator</li>
          <li MayRequire="Ludeon.RimWorld.Biotech">PowerfocusChip</li>
          <li MayRequire="Ludeon.RimWorld.Biotech">NanostructuringChip</li>
        </verboteneDinge>
      </li>
    </modExtensions>
    <questNameRules>
      <rulesStrings>
        <li>questName->The Siege of [asker_nameDef]'s [place]</li>
        <li>questName->[place] under Attack</li>
        <li>questName->Relief for [asker_nameDef]</li>
        <li>place->Village</li>
        <li>place->Settlement</li>
        <li>place->Town</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[asker_nameFull], [asker_faction_leaderTitle] of [asker_faction_name], asks for urgent help. [angreiferFaction_pawnsPlural] of [angreiferFaction_name] are storming one of [asker_possessive] settlements. The walls are breached and parts of it are burning. The defenders are still holding out, but they will not last long on their own.\n\nHelp them drive off the attackers. If the defenders fall before the attackers are beaten, the settlement is lost.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
          <parms>
            <pointsFactorTwoStar>1.5</pointsFactorTwoStar>
            <pointsFactorThreeStar>2</pointsFactorThreeStar>
          </parms>
        </li>

        <li Class="QuestNode_SubScript">
          <def>Util_AdjustPointsForDistantFight</def>
        </li>

        <li Class="QuestNode_GetMap" />

        <li Class="CustomBaseFramework.QuestNode_CBFAuftraggeber">
          <storeAs>asker</storeAs>
          <storeFactionAs>askerFaction</storeFactionAs>
          <sitePart>CBF_MO_Quest_UmkaempfterOrt</sitePart>
        </li>

        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>

        <li Class="CustomBaseFramework.QuestNode_CBFBesatzer">
          <storeAs>angreiferFaction</storeAs>
          <storeSitePartDefsAs>sitePartDefs</storeSitePartDefsAs>
          <sitePart>CBF_MO_Quest_UmkaempfterOrt</sitePart>
          <feindVon>$askerFaction</feindVon>
        </li>

        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$askerFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>

        <li Class="QuestNode_GetSiteThreatPoints">
          <storeAs>sitePoints</storeAs>
          <sitePartsParams>$sitePartsParams</sitePartsParams>
        </li>

        <li Class="QuestNode_Multiply">
          <value1>$sitePoints</value1>
          <value2>3</value2>
          <storeAs>angreiferPunkte</storeAs>
        </li>

        <li Class="QuestNode_SubScript">
          <def>Util_GetDefaultRewardValueFromPoints</def>
          <parms>
            <points>$sitePoints</points>
          </parms>
        </li>

        <li Class="QuestNode_Multiply">
          <value1>$rewardValue</value1>
          <value2>1.75</value2>
          <storeAs>rewardValue</storeAs>
        </li>

        <li Class="QuestNode_GenerateSite">
          <sitePartsParams>$sitePartsParams</sitePartsParams>
          <faction>$askerFaction</faction>
          <tile>$siteTile</tile>
          <worldObjectDef>CBF_MO_Quest_UmkaempfterOrt</worldObjectDef>
          <storeAs>site</storeAs>
        </li>

        <li Class="CustomBaseFramework.QuestNode_CBFOrt">
          <site>$site</site>
          <bauherr>$askerFaction</bauherr>
          <punkte>$sitePoints</punkte>
        </li>

        <li Class="CustomBaseFramework.QuestNode_CBFAngriff">
          <site>$site</site>
          <angreifer>$angreiferFaction</angreifer>
          <punkte>$angreiferPunkte</punkte>
        </li>

        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>

        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>$(randInt(3,6)*60000)</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <destroyOnCleanup>true</destroyOnCleanup>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="CBF_Quest_LetterLabelZuSpaet">Quest failed: [resolvedQuestName]</label>
                <text TKey="CBF_Quest_LetterTextZuSpaet">We did not arrive in time. The settlement has fallen to the attackers. The quest [resolvedQuestName] has failed.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.VerteidigerGefallen</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="CBF_Quest_LetterLabelGefallen">Quest failed: [resolvedQuestName]</label>
                <text TKey="CBF_Quest_LetterTextGefallen">The last defenders have fallen. The settlement is lost. The quest [resolvedQuestName] has failed.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_SignalActivable">
          <inSignal>site.Destroyed</inSignal>
          <inSignalDisable>site.AllEnemiesDefeated</inSignalDisable>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="CBF_Quest_LetterLabelVerlassen">Quest failed: [resolvedQuestName]</label>
                <text TKey="CBF_Quest_LetterTextVerlassen">We left the settlement while the attackers were still there. The quest [resolvedQuestName] has ended.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <node Class="QuestNode_GiveRewards">
            <parms>
              <allowGoodwill>true</allowGoodwill>
              <allowRoyalFavor>true</allowRoyalFavor>
              <chosenPawnSignal>ChosenPawnForReward</chosenPawnSignal>
            </parms>
            <customLetterLabel TKey="CBF_Quest_LetterLabelLohn">Payment arrived</customLetterLabel>
            <customLetterText TKey="CBF_Quest_LetterTextLohn">The attackers are beaten and the settlement is saved.\n\nThe payment from [asker_faction_name] has arrived.</customLetterText>
            <nodeIfChosenPawnSignalUsed Class="QuestNode_Letter">
              <letterDef>ChoosePawn</letterDef>
              <label TKey="CBF_Quest_LetterLabelGunst">[asker_faction_royalFavorLabel]</label>
              <text TKey="CBF_Quest_LetterTextGunst">These colonists took part in the fight for [resolvedQuestName]. [asker_definite] wants to know who should receive the [royalFavorReward_amount] [asker_faction_royalFavorLabel] for this service.</text>
              <useColonistsOnMap>$site</useColonistsOnMap>
              <chosenPawnSignal>ChosenPawnForReward</chosenPawnSignal>
            </nodeIfChosenPawnSignalUsed>
          </node>
        </li>

        <li Class="QuestNode_End">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <outcome>Success</outcome>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
