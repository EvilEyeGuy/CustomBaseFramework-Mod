<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Medieval Overhaul</li>
    </mods>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ScenarioDef[defName="DankPyon_MercenaryStart"]/scenario/parts</xpath>
      <match Class="PatchOperationSequence">
        <operations>
          <li Class="PatchOperationConditional">
            <xpath>/Defs/ScenarioDef[defName="DankPyon_MercenaryStart"]/scenario/parts/li[@Class="CustomBaseFramework.ScenPart_CBFAncientDangers"]</xpath>
            <match Class="PatchOperationRemove">
              <xpath>/Defs/ScenarioDef[defName="DankPyon_MercenaryStart"]/scenario/parts/li[@Class="CustomBaseFramework.ScenPart_CBFAncientDangers"]</xpath>
            </match>
          </li>
          <li Class="PatchOperationAdd">
            <xpath>/Defs/ScenarioDef[defName="DankPyon_MercenaryStart"]/scenario/parts</xpath>
            <value>
              <li Class="CustomBaseFramework.ScenPart_CBFAncientDangers">
                <def>CBF_AncientDangers</def>
                <mode>OwnOnly</mode>
                <vanillaWeight>0</vanillaWeight>
                <categories>
                  <li>CBF_MO_AncientDangerMedieval</li>
                </categories>
                <fallbackVanilla>false</fallbackVanilla>
              </li>
            </value>
          </li>
        </operations>
      </match>
    </match>
  </Operation>
