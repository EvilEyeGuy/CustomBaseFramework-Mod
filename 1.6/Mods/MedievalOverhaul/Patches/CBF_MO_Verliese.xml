      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnKindDef[defName="DankPyon_LindwurmCave"]/defaultFactionType</xpath>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/PawnKindDef[defName="DankPyon_LindwurmCave"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/PawnKindDef[defName="DankPyon_LindwurmCave"]</xpath>
        <value>
          <defaultFactionType>DankPyon_SnakeCave_Faction</defaultFactionType>
        </value>
      </match>
    </nomatch>
