  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[@Name="DankPyon_ShadowSectBase"]/pawnGroupMakers</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/FactionDef[@Name="DankPyon_ShadowSectBase"]</xpath>
      <value>
        <pawnGroupMakers>
          <li>
            <kindDef>Combat</kindDef>
            <commonality>100</commonality>
            <options>
              <DankPyon_Cultist_Novice>10</DankPyon_Cultist_Novice>
              <DanyPyon_Cultist_Acolyte_Melee>8</DanyPyon_Cultist_Acolyte_Melee>
              <DanyPyon_Cultist_Acolyte_Ranged>8</DanyPyon_Cultist_Acolyte_Ranged>
              <DanyPyon_Cultist_Adept_Melee>4</DanyPyon_Cultist_Adept_Melee>
              <DanyPyon_Cultist_Adept_Ranged>4</DanyPyon_Cultist_Adept_Ranged>
              <DanyPyon_Cultist_HighPriest_Melee>1</DanyPyon_Cultist_HighPriest_Melee>
              <DanyPyon_Cultist_HighPriest_Ranged>1</DanyPyon_Cultist_HighPriest_Ranged>
            </options>
          </li>
          <li>
            <kindDef>Settlement</kindDef>
            <commonality>100</commonality>
            <options>
              <DankPyon_Cultist_Novice>10</DankPyon_Cultist_Novice>
              <DanyPyon_Cultist_Acolyte_Melee>8</DanyPyon_Cultist_Acolyte_Melee>
