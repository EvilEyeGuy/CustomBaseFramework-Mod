<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/GenStepDef[defName="Cultist_1Tier_Generation"]/genStep</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/GenStepDef[defName="Cultist_1Tier_Generation"]/genStep</xpath>
      <value>
        <genStep Class="CustomBaseFramework.GenStep_CBFSettlement">
          <forcePlan>CBF_Plan_Dungeon_CultHideout_T1</forcePlan>
          <fallbackToVanilla>false</fallbackToVanilla>
        </genStep>
      </value>
    </match>
  </Operation>

