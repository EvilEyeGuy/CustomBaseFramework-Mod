<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>CBF_DungeonStairsDown</defName>
    <label>stairs down</label>
    <description>Worn stone steps that spiral down into the darkness below.</description>
    <thingClass>CustomBaseFramework.Verliestreppe</thingClass>
    <size>(3,3)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>1</costStuffCount>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <graphicData>
      <texPath>CBF/Stairs/Lala_Down</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <isTargetable>false</isTargetable>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
      <isEdifice>false</isEdifice>
    </building>
    <portal>
      <pocketMapGenerator>CBF_DungeonLevel</pocketMapGenerator>
      <exitDef>CBF_DungeonStairsUp</exitDef>
      <pocketMapSize>150</pocketMapSize>
    </portal>
    <inspectorTabs>
      <li>ITab_ContentsMapPortal</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef ParentName="PocketMapExit">
    <defName>CBF_DungeonStairsUp</defName>
    <thingClass>CustomBaseFramework.Verliesausgang</thingClass>
    <label>stairs up</label>
    <description>Worn stone steps that lead back up to the level above.</description>
    <size>(3,3)</size>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>1</costStuffCount>
    <altitudeLayer>Building</altitudeLayer>
    <graphicData>
      <texPath>CBF/Stairs/Lala_Up</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
    </building>
  </ThingDef>

</Defs>
