<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.SettlementPlanDef MayRequire="DankPyon.Medieval.Overhaul">
    <defName>CBF_Plan_RIAF_Hamlet</defName>
    <label>hamlet (RIAF, MO)</label>
    <materialList>CBF_MO_MaterialList</materialList>

    <styles>
      <li>Rustical</li>
      <li>Standard</li>
    </styles>

    <coreSize>34~42</coreSize>
    <mapSize>150</mapSize>
    <towerCorner>7</towerCorner>
    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <maxBuildingGap>3</maxBuildingGap>
    <targetBuilt>0.5</targetBuilt>
    <defenderPoints>150~300</defenderPoints>
    <defendersOnWall>0.28</defendersOnWall>

    <wards>
      <li>
        <kind>Town</kind>
        <name>VillageCore</name>
        <gate>DankPyon_ReinfocedLogGate</gate>
        <supply>1.2</supply>
        <walls>
          <li MayRequire="DankPyon.Medieval.Overhaul">Palisade</li>
        </walls>
        <emplacements>
          <li><tag>CBF_MO_PalisadeTower</tag><count>1~1</count></li>
        </emplacements>
        <gatehouses>
          <li><tag>CBF_MO_PalisadeGatehouse</tag><count>1~1</count></li>
        </gatehouses>
        <garrison>
          <li><list>CBF_MO_Garrison_Walkway</list><post>Walkway</post><count>3~5</count></li>
          <li><list>CBF_MO_Garrison_Gate</list><post>Gate</post><count>1~3</count></li>
          <li><list>CBF_MO_Garrison_Inside</list><post>Inside</post><count>1~3</count></li>
        </garrison>
        <districts>
          <li>
            <name>VillageSquare</name>
            <entries>
              <li><tag>CBF_MO_Tavern</tag><count>1~1</count></li>
              <li><tag>CBF_MO_Workshop</tag><count>0~1</count></li>
              <li><tag>CBF_MO_Church</tag><count>1~1</count></li>
              <li><tag>CBF_MO_Shrine</tag><count>0~1</count></li>
              <li><piece>CBF_MO_Armory_D</piece><count>0~1</count></li>
              <li><tag>CBF_MO_Folk</tag><count>0~5</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Suburb</kind>
        <name>OuterFarms</name>
        <supply>1.2</supply>
        <garrison>
          <li><list>CBF_MO_Garrison_Inside</list><post>Inside</post><count>1~3</count></li>
        </garrison>
        <districts>
          <li>
            <name>Farms</name><fields><li>
              <count>2~4</count>
              <fence>true</fence>
              <weight>1</weight><plants>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Carrots</li>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Garlic</li>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Onions</li>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Pumpkins</li>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Wheat</li>
                <li>Plant_Corn</li>
               </plants>
              <tags>
                <li>CBF_MO_Hut</li>
                <li>CBF_MO_Farmstead</li>
              </tags></li></fields>
            <entries>
              <li><tag>CBF_MO_Hut</tag><count>0~3</count><filler>true</filler></li>
              <li><tag>CBF_MO_Farmstead</tag><count>1~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Countryside</name>
        <supply>1.2</supply>
        <garrison>
          <li><list>CBF_MO_Garrison_Inside</list><post>Inside</post><count>1~3</count></li>
        </garrison>
        <districts>
          <li>
            <name>Mill</name><fields><li>
              <count>2~3</count>
              <fence>false</fence>
              <weight>1</weight><plants>
                <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Wheat</li>
               </plants>
              <tags>
                <li>CBF_MO_Mill</li>
              </tags></li></fields>
            <entries>
              <li><tag>CBF_MO_Mill</tag><count>1~1</count></li>
            </entries>
          </li>
          <li>
            <name>Pasture</name><pens><li>
              <name>Pen</name>
              <count>1~1</count>
              <herd>2~5</herd>
              <pawns>Hardanimals_1</pawns>
              <terrain>Soil</terrain><plants>
                <li>Plant_Haygrass</li>
               </plants>
              <weight>1</weight></li></pens>
            <entries>
              <li><tag>CBF_MO_Barn</tag><count>0~1</count></li>
              <li><tag>CBF_MO_Hut</tag><count>0~1</count></li>
            </entries>
          </li>
          <li>
            <name>Churchyard</name>
            <entries>
              <li><tag>CBF_MO_Graveyard</tag><count>0~1</count></li>
            </entries>
          </li>
          <li>
            <name>Edge</name>
            <entries>
              <li><tag>CBF_MO_Hut</tag><count>0~1</count></li>
              <li><tag>CBF_MO_HuntingLodge</tag><count>0~1</count></li>
              <li><tag>CBF_MO_Winery</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>

    <kind>MedievalTown</kind>

    <worldTexture>World/WorldObjects/CBF/CBF_VillagePalisade</worldTexture>
      <riafHolding>Village</riafHolding>
    <forAllFactions>true</forAllFactions>
    <techLevels>
      <li>Medieval</li>
    </techLevels>
  </CustomBaseFramework.SettlementPlanDef>

  <CustomBaseFramework.SettlementPlanDef MayRequire="DankPyon.Medieval.Overhaul">
    <defName>CBF_Plan_RIAF_MarketTown</defName>
    <label>small market town (RIAF, MO)</label>
    <materialList>CBF_MO_MaterialList</materialList>

    <styles>
      <li>Rustical</li>
      <li>Standard</li>
    </styles>

    <coreSize>56~64</coreSize>
    <mapSize>150</mapSize>
    <towerCorner>7</towerCorner>
    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <maxBuildingGap>2</maxBuildingGap>
    <targetBuilt>0.5</targetBuilt>
    <defenderPoints>260~480</defenderPoints>
    <defendersOnWall>0.28</defendersOnWall>

    <wards>
      <li>
        <kind>Town</kind>
        <name>OldTown</name>
        <supply>1.2</supply>
        <roads>
          <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Floor_Cobblestone_Granite</li>
        </roads>
        <walls>
          <li><piece>TownWall</piece><weight>0.75</weight></li>
          <li><piece>CBF_MO_TownWall_Embrasure</piece><weight>0.25</weight></li>
        </walls>
        <emplacements>
          <li><tag>CBF_MO_TownTower</tag><count>1~1</count></li>
        </emplacements>
        <gatehouses>
          <li><tag>CBF_MO_Gatehouse</tag><count>1~1</count></li>
        </gatehouses>
        <garrison>
          <li><list>CBF_MO_Garrison_Walkway</list><post>Walkway</post><count>6~9</count></li>
          <li><list>CBF_MO_Garrison_Gate</list><post>Gate</post><count>3~4</count></li>
          <li><list>CBF_MO_Garrison_Inside</list><post>Inside</post><count>4~5</count></li>
        </garrison>
        <districts>
          <li>
            <name>Castle</name>
            <entries>
              <li><tag>CBF_MO_Keep</tag><count>1~1</count><unique>true</unique></li>
              <li><tag>CBF_MO_Barracks</tag><count>0~1</count></li>
              <li><tag>CBF_MO_Armory</tag><count>0~1</count></li>
              <li><piece>CBF_MO_Dungeon</piece><count>0~1</count></li>
            </entries>
          </li>
          <li>
            <name>Center</name>
            <entries>
              <li><tag>CBF_MO_NobleHouse</tag><count>0~1</count></li>
              <li><tag>CBF_MO_Guild</tag><count>0~1</count></li>
              <li><tag>CBF_MO_Tavern</tag><count>1~1</count></li>
              <li><tag>CBF_MO_MarketSquare</tag><count>1~1</count></li>
              <li><tag>CBF_MO_CatapultEmplacement</tag><count>0~1</count></li>
              <li><tag>CBF_MO_WallAccess</tag><count>0~1</count></li>
              <li><tag>CBF_MO_Church</tag><count>1~1</count></li>
              <li><tag>CBF_MO_Monument</tag><count>0~1</count></li>
              <li><tag>CBF_MO_BurgherHouse</tag><count>0~4</count><filler>true</filler></li>
              <li><tag>CBF_MO_GapYard</tag><count>0~2</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>

    <kind>MedievalTown</kind>

    <worldTexture>World/WorldObjects/CBF/CBF_MarketTown</worldTexture>
      <riafHolding>Town</riafHolding>
    <forAllFactions>true</forAllFactions>
    <techLevels>
      <li>Medieval</li>
    </techLevels>
  </CustomBaseFramework.SettlementPlanDef>

