<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <CustomBaseFramework.StyleDef>
    <defName>CBF_VFEM2</defName>
    <label>Medieval 2</label>
  </CustomBaseFramework.StyleDef>

  <CustomBaseFramework.PawnListDef>
    <defName>CBF_VFEM2_Residents</defName>
    <label>residents</label>
    <role>Civilian</role>
    <radius>4</radius>
    <members>
      <li><kind>VFEM2_Peasant</kind><weight>10</weight></li>
      <li><kind>VFEM2_Trader</kind><weight>1</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>

  <CustomBaseFramework.PawnListDef>
    <defName>CBF_VFEM2_Garrison_Walkway</defName>
    <label>wall garrison</label>
    <role>Sentry</role>
    <radius>4</radius>
    <members>
      <li><kind>VFEM2_Archer</kind><weight>2</weight></li>
      <li><kind>VFEM2_Crossbowman</kind><weight>2</weight></li>
      <li><kind>VFEM2_HeavyArcher</kind><weight>1</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>

  <CustomBaseFramework.PawnListDef>
    <defName>CBF_VFEM2_Garrison_Gate</defName>
    <label>gate garrison</label>
    <role>Guard</role>
    <radius>4</radius>
    <members>
      <li><kind>VFEM2_Halberdier</kind><weight>2</weight></li>
      <li><kind>VFEM2_ManAtArms</kind><weight>1</weight></li>
      <li><kind>VFEM2_Knight</kind><weight>1</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>

  <CustomBaseFramework.PawnListDef>
    <defName>CBF_VFEM2_Garrison_Inside</defName>
    <label>inner garrison</label>
    <role>Guard</role>
    <radius>4</radius>
    <members>
      <li><kind>VFEM2_Knight</kind><weight>1</weight></li>
      <li><kind>VFEM2_ManAtArms</kind><weight>2</weight></li>
      <li><kind>VFEM2_Halberdier</kind><weight>1</weight></li>
      <li><kind>VFEM2_Crossbowman</kind><weight>1</weight></li>
    </members>
  </CustomBaseFramework.PawnListDef>

</Defs>
