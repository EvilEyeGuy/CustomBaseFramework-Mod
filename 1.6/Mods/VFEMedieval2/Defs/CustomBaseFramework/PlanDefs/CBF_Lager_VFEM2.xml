  <CustomBaseFramework.SettlementPlanDef>
    <defName>CBF_Plan_Camp_VFEM2_Bandits</defName>
    <label>bandit camp (VFE M2)</label>
    <materialList>CBF_VFEM2_MaterialList</materialList>
    <kind>Camp</kind>
    <styles>
      <li>CBF_VFEM2</li>
    </styles>
    <coreSize>36~46</coreSize>
    <mapSize>200</mapSize>
    <roadMain>1</roadMain>
    <roadLane>1</roadLane>
    <minBuildingGap>2</minBuildingGap>
    <maxBuildingGap>4</maxBuildingGap>
    <targetBuilt>0.3</targetBuilt>
    <treeShare>0.15</treeShare>
    <defenderPoints>150~300</defenderPoints>
    <wards>
      <li>
        <kind>Town</kind>
        <name>Camp</name>
        <supply>1.2</supply>
        <walls>
          <li><piece>CBF_VFEM2_BarricadeWall</piece><weight>0.5</weight></li>
          <li><piece>CBF_VFEM2_Palisade</piece><weight>0.5</weight></li>
