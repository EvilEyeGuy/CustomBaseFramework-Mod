<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <CustomBaseFramework.SettlementPlanDef MayRequire="OskarPotocki.VanillaFactionsExpanded.SettlersModule">
    <defName>CBF_Plan_Western_Village</defName>
    <label>frontier village (VFE Settlers)</label>
    <materialList>CBF_Western_MaterialList</materialList>
    <styles>
      <li>CBF_Western</li>
    </styles>
    <coreSize>45~55</coreSize>
    <mapSize>200</mapSize>
    <towerCorner>5</towerCorner>
    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <maxBuildingGap>3</maxBuildingGap>
    <targetBuilt>0.5</targetBuilt>
    <defenderPoints>150~300</defenderPoints>
    <defendersOnWall>0.28</defendersOnWall>
    <wards>
      <li>
        <kind>Town</kind>
        <name>Main</name>
        <supply>1.2</supply>
        <walls>
          <li>CBF_Western_Palisade_A</li>
        </walls>
        <emplacements>
          <li><tag>CBF_Western_WallTower</tag><count>1~3</count></li>
        </emplacements>
        <gatehouses>
          <li><tag>CBF_Western_Gatehouse</tag><count>1~2</count></li>
        </gatehouses>
        <garrison>
          <li>
            <list>CBF_Western_Garrison_Walkway</list>
            <count>3~5</count>
            <post>Walkway</post>
          </li>
          <li>
            <list>CBF_Western_Garrison_Gate</list>
            <count>1~3</count>
            <post>Gate</post>
          </li>
          <li>
            <list>CBF_Western_Garrison_Inside</list>
            <count>1~3</count>
            <post>Inside</post>
          </li>
        </garrison>
        <districts>
          <li>
            <name>Street</name>
            <entries>
              <li><tag>CBF_Western_Saloon</tag><count>1~1</count></li>
              <li><tag>CBF_Western_Store</tag><count>1~1</count></li>
              <li><tag>CBF_Western_Sheriff</tag><count>0~1</count></li>
              <li><tag>CBF_Western_Smithy</tag><count>1~1</count></li>
              <li><tag>CBF_Western_Stable</tag><count>0~1</count></li>
              <li><tag>CBF_Western_Church</tag><count>0~1</count></li>
              <li><tag>CBF_Western_Workshop</tag><count>1~2</count></li>
              <li><tag>CBF_Western_House</tag><count>7~10</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Countryside</name>
        <supply>1.2</supply>
        <garrison>
          <li>
            <list>CBF_Western_Garrison_Inside</list>
            <count>1~3</count>
            <post>Inside</post>
          </li>
        </garrison>
        <districts>
          <li>
            <name>Farms</name><fields><li>
              <count>2~4</count>
              <fence>true</fence>
              <weight>1</weight><plants>
                <li>Plant_Corn</li>
                <li>Plant_Potato</li>
                <li>Plant_Rice</li>
               </plants>
              <tags>
                <li>CBF_Western_House</li>
              </tags></li></fields>
            <entries>
              <li><tag>CBF_Western_House</tag><count>1~2</count></li>
            </entries>
          </li>
          <li>
            <name>Mill</name><fields><li>
              <count>2~3</count>
              <fence>false</fence>
              <weight>1</weight><plants>
                <li>Plant_Corn</li>
                <li>Plant_Potato</li>
                <li>Plant_Rice</li>
               </plants>
              <tags>
                <li>CBF_Western_Windmill</li>
              </tags></li></fields>
            <entries>
              <li><tag>CBF_Western_Windmill</tag><count>1~2</count></li>
            </entries>
          </li>
          <li>
            <name>Ranch</name><pens><li>
              <name>Pen</name>
              <count>1~1</count>
              <herd>3~6</herd>
              <pawns>Hardanimals_1</pawns>
              <terrain>Soil</terrain><plants>
                <li>Plant_Haygrass</li>
               </plants>
              <weight>1</weight></li></pens>
            <entries>
              <li><tag>CBF_Western_Stable</tag><count>0~1</count></li>
              <li><tag>CBF_Western_House</tag><count>0~1</count></li>
            </entries>
          </li>
          <li>
            <name>Boothill</name>
            <entries>
              <li><tag>CBF_Western_Graveyard</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
    <kind>MedievalTown</kind>
    <factionTags>
      <li>SettlerCivil</li>
      <li>SettlerRough</li>
      <li>SettlerSavage</li>
    </factionTags>
    <share>0</share>
    <wdLevel>1</wdLevel>
    <forAllFactions>false</forAllFactions>
    <techLevels>
      <li>Industrial</li>
    </techLevels>
    <worldTexture>World/WorldObjects/CBF/CBF_VillagePalisade</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>
</Defs>
