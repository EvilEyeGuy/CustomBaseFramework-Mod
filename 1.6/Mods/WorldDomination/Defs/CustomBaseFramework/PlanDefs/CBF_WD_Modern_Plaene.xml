<Defs>

  <CustomBaseFramework.SettlementPlanDef>
    <defName>CBF_Plan_WD_Modern_Farmposten</defName>
    <label>farm outpost</label>
    <materialList>CBF_Modern_Materialliste</materialList>
    <styles>
      <li>CBF_ModernVanilla</li>
    </styles>
    <coreSize>34~42</coreSize>
    <mapSize>175</mapSize>
    <towerCorner>5</towerCorner>
    <towerCurtain>7</towerCurtain>
    <towerCapTotal>0</towerCapTotal>
    <wallGap>1</wallGap>
    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <maxBuildingGap>3</maxBuildingGap>
    <targetBuilt>0.45</targetBuilt>
    <weightNearRoad>1.4</weightNearRoad>
    <defenderPoints>120~220</defenderPoints>
    <defendersOnWall>0.25</defendersOnWall>
    <wards>
      <li>
        <art>Stadt</art>
        <name>Posten</name>
        <versorgung>1.2</versorgung>
        <garrison>
          <li><list>CBF_Modern_Garnison_Innen</list><posten>Innen</posten><count>3~5</count></li>
        </garrison>
        <districts>
          <li>
            <name>Hof</name>
            <entries>
              <li><tag>CBF_Vanilla_Silo</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_HouseSmall</tag><count>2~4</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Umland</art>
        <name>Umland</name>
        <versorgung>1.2</versorgung>
        <districts>
          <li>
            <name>Felder</name><fields><li>
                <count>2~3</count>
                <fence>false</fence>
                <weight>1</weight><plants>
                  <li>Plant_Rice</li>
                  <li>Plant_Corn</li>
                  <li>Plant_Potato</li>
                </plants>
                <tags>
                  <li>CBF_Vanilla_Silo</li>
                </tags></li></fields>
            <entries>
              <li><tag>CBF_Vanilla_Gehege</tag><count>1~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
    <kind>Modernestadt</kind>
    <anteil>0</anteil>
    <wdStufe>1</wdStufe>
    <wdTyp>
      <li>Farming</li>
    </wdTyp>
    <fuerAlleFraktionen>true</fuerAlleFraktionen>
    <techLevels>
      <li>Industrial</li>
      <li>Spacer</li>
      <li>Ultra</li>
    </techLevels>
    <worldTexture>World/WorldObjects/CBF/CBF_ModernVillage</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>

