<Defs>

  <CustomBaseFramework.SettlementPlanDef>
    <defName>CBF_Plan_WD_Modern_FarmOutpost</defName>
    <label>farm outpost</label>
    <materialList>CBF_Modern_MaterialList</materialList>
    <styles>
      <li>CBF_ModernVanilla</li>
    </styles>
    <coreSize>34~42</coreSize>
    <mapSize>175</mapSize>
    <towerCorner>5</towerCorner>
    <towerCurtain>7</towerCurtain>
    <towerCapTotal>0</towerCapTotal>
    <wallGap>1</wallGap>
    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <maxBuildingGap>3</maxBuildingGap>
    <targetBuilt>0.45</targetBuilt>
    <weightNearRoad>1.4</weightNearRoad>
    <defenderPoints>120~220</defenderPoints>
    <defendersOnWall>0.25</defendersOnWall>
    <wards>
      <li>
        <kind>Town</kind>
        <name>Outpost</name>
        <supply>1.2</supply>
        <garrison>
          <li><list>CBF_Modern_Garrison_Inside</list><post>Inside</post><count>3~5</count></li>
        </garrison>
        <districts>
          <li>
            <name>Farmstead</name>
            <entries>
              <li><tag>CBF_Vanilla_Silo</tag><count>1~2</count></li>
              <li><tag>CBF_Vanilla_HouseSmall</tag><count>2~4</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Countryside</name>
        <supply>1.2</supply>
        <districts>
          <li>
            <name>Fields</name><fields><li>
                <count>2~3</count>
                <fence>false</fence>
                <weight>1</weight><plants>
                  <li>Plant_Rice</li>
                  <li>Plant_Corn</li>
                  <li>Plant_Potato</li>
                </plants>
                <tags>
                  <li>CBF_Vanilla_Silo</li>
                </tags></li></fields>
            <entries>
              <li><tag>CBF_Vanilla_Pen</tag><count>1~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
    <kind>ModernTown</kind>
    <share>0</share>
    <wdLevel>1</wdLevel>
    <wdType>
      <li>Farming</li>
    </wdType>
    <forAllFactions>true</forAllFactions>
    <ideoStyle>true</ideoStyle>
    <techLevels>
      <li>Industrial</li>
      <li>Spacer</li>
      <li>Ultra</li>
    </techLevels>
    <worldTexture>World/WorldObjects/CBF/CBF_ModernVillage</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>

