    <wallGap>1</wallGap>
    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <maxBuildingGap>3</maxBuildingGap>
    <targetBuilt>0.45</targetBuilt>
    <weightNearRoad>1.4</weightNearRoad>
    <defenderPoints>80~160</defenderPoints>
    <defendersOnWall>0.25</defendersOnWall>
    <wards>
      <li>
        <kind>Town</kind>
        <name>Lager</name>
        <supply>1.2</supply>
        <walls>
          <li MayRequire="DankPyon.Medieval.Overhaul">Palisade</li>
        </walls>
        <emplacements>
          <li><tag>CBF_MO_Palisadenturm</tag><count>1~1</count></li>
        </emplacements>
        <garrison>
          <li><list>CBF_MO_Garnison_Innen</list><post>Inside</post><count>2~4</count></li>
        </garrison>
        <districts>
          <li>
            <name>Hof</name>
            <entries>
              <li><tag>CBF_MO_Kornspeicher</tag><count>1~2</count></li>
              <li><tag>CBF_MO_Bauernhof</tag><count>1~2</count></li>
              <li><tag>CBF_MO_Huette</tag><count>3~6</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Umland</name>
        <supply>1.2</supply>
        <districts>
          <li>
            <name>Felder</name><fields><li>
                <count>2~3</count>
                <fence>false</fence>
                <weight>1</weight><plants>
                  <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Wheat</li>
                  <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Carrots</li>
                  <li>Plant_Corn</li>
                </plants>
                <tags>
                  <li>CBF_MO_Kornspeicher</li>
                  <li>CBF_MO_Scheune</li>
                </tags></li></fields>
            <entries>
              <li><tag>CBF_MO_Gehege</tag><count>1~2</count></li>
              <li><tag>CBF_MO_Scheune</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
    <kind>MedievalTown</kind>
    <factionTags>
      <li>DankPyon_NobleHouseSavage</li>
      <li>DankPyon_NobleHouseFierce</li>
      <li>DankPyon_NobleHouseCivil</li>
      <li>DankPyon_NobleHouseCivil2</li>
    </factionTags>
    <share>0</share>
    <wdLevel>1</wdLevel>
    <wdType>
      <li>Farming</li>
    </wdType>
    <forAllFactions>true</forAllFactions>
    <techLevels>
      <li>Medieval</li>
    </techLevels>
    <worldTexture>World/WorldObjects/CBF/CBF_VillagePalisade</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>

