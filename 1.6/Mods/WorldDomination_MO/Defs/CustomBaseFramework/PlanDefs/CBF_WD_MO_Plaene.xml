<Defs>

  <CustomBaseFramework.SettlementPlanDef MayRequire="DankPyon.Medieval.Overhaul">
    <defName>CBF_Plan_WD_MO_FarmCamp</defName>
    <label>farm camp (MO)</label>
    <materialList>CBF_MO_MaterialList</materialList>
    <styles>
      <li>Rustical</li>
      <li>Standard</li>
    </styles>
    <coreSize>34~42</coreSize>
    <mapSize>175</mapSize>
    <towerCorner>5</towerCorner>
    <towerCurtain>7</towerCurtain>
    <towerCapTotal>0</towerCapTotal>
    <wallGap>1</wallGap>
    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <maxBuildingGap>3</maxBuildingGap>
    <targetBuilt>0.45</targetBuilt>
    <weightNearRoad>1.4</weightNearRoad>
    <defenderPoints>80~160</defenderPoints>
    <defendersOnWall>0.25</defendersOnWall>
    <wards>
      <li>
        <kind>Town</kind>
        <name>Lager</name>
        <supply>1.2</supply>
        <walls>
          <li MayRequire="DankPyon.Medieval.Overhaul">Palisade</li>
        </walls>
        <emplacements>
          <li><tag>CBF_MO_PalisadeTower</tag><count>1~1</count></li>
        </emplacements>
        <garrison>
          <li><list>CBF_MO_Garrison_Inside</list><post>Inside</post><count>2~4</count></li>
        </garrison>
        <districts>
          <li>
            <name>Hof</name>
            <entries>
              <li><tag>CBF_MO_Granary</tag><count>1~2</count></li>
              <li><tag>CBF_MO_Farmstead</tag><count>1~2</count></li>
              <li><tag>CBF_MO_Hut</tag><count>3~6</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Umland</name>
        <supply>1.2</supply>
        <districts>
          <li>
            <name>Felder</name><fields><li>
                <count>2~3</count>
                <fence>false</fence>
                <weight>1</weight><plants>
                  <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Wheat</li>
                  <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Plant_Carrots</li>
                  <li>Plant_Corn</li>
                </plants>
                <tags>
                  <li>CBF_MO_Granary</li>
                  <li>CBF_MO_Barn</li>
                </tags></li></fields>
            <entries>
              <li><tag>CBF_MO_Pen</tag><count>1~2</count></li>
              <li><tag>CBF_MO_Barn</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
    <kind>MedievalTown</kind>
    <factionTags>
      <li>DankPyon_NobleHouseSavage</li>
      <li>DankPyon_NobleHouseFierce</li>
      <li>DankPyon_NobleHouseCivil</li>
      <li>DankPyon_NobleHouseCivil2</li>
    </factionTags>
    <share>0</share>
    <wdLevel>1</wdLevel>
    <wdType>
      <li>Farming</li>
    </wdType>
    <forAllFactions>true</forAllFactions>
    <techLevels>
      <li>Medieval</li>
    </techLevels>
    <worldTexture>World/WorldObjects/CBF/CBF_VillagePalisade</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>

