<Defs>

  <CustomBaseFramework.SettlementPlanDef>
    <defName>CBF_Plan_WD_VFEM2_Farmlager</defName>
    <label>farm camp (VFE Medieval 2)</label>
    <materialList>CBF_VFEM2_Materialliste</materialList>
    <styles>
      <li>CBF_VFEM2</li>
    </styles>
    <coreSize>34~42</coreSize>
    <mapSize>175</mapSize>
    <towerCorner>5</towerCorner>
    <towerCurtain>7</towerCurtain>
    <towerCapTotal>0</towerCapTotal>
    <wallGap>1</wallGap>
    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <maxBuildingGap>3</maxBuildingGap>
    <targetBuilt>0.45</targetBuilt>
    <weightNearRoad>1.4</weightNearRoad>
    <defenderPoints>80~160</defenderPoints>
    <defendersOnWall>0.25</defendersOnWall>
    <wards>
      <li>
        <art>Stadt</art>
        <name>Lager</name>
        <versorgung>1.2</versorgung>
        <walls>
          <li>Palisade</li>
        </walls>
        <emplacements>
          <li><tag>CBF_VFEM2_Palisadenturm</tag><count>1~1</count></li>
        </emplacements>
        <garrison>
          <li><list>CBF_VFEM2_Garnison_Innen</list><posten>Innen</posten><count>2~4</count></li>
        </garrison>
        <districts>
          <li>
            <name>Hof</name>
            <entries>
              <li><tag>CBF_VFEM2_Kornspeicher</tag><count>1~2</count></li>
              <li><tag>CBF_VFEM2_Bauernhof</tag><count>1~2</count></li>
              <li><tag>CBF_VFEM2_Huette</tag><count>3~6</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <art>Umland</art>
        <name>Umland</name>
        <versorgung>1.2</versorgung>
        <districts>
          <li>
            <name>Felder</name><fields><li>
                <count>2~3</count>
                <fence>false</fence>
                <weight>1</weight><plants>
                  <li>Plant_Corn</li>
                  <li>Plant_Potato</li>
                </plants>
                <tags>
                  <li>CBF_VFEM2_Kornspeicher</li>
                  <li>CBF_VFEM2_Scheune</li>
                </tags></li></fields>
            <entries>
              <li><tag>CBF_VFEM2_Gehege</tag><count>1~2</count></li>
              <li><tag>CBF_VFEM2_Scheune</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
    <kind>Mittelalterstadt</kind>
    <factionTags>
      <li>VFEM2_KingdomCivil</li>
      <li>VFEM2_KingdomRough</li>
      <li>VFEM2_KingdomSavage</li>
      
      
      
      
    </factionTags>
    <anteil>0</anteil>
    <wdStufe>1</wdStufe>
    <wdTyp>
      <li>Farming</li>
    </wdTyp>
    <fuerAlleFraktionen>true</fuerAlleFraktionen>
    <techLevels>
      <li>Medieval</li>
    </techLevels>
    <worldTexture>World/WorldObjects/CBF/CBF_VillagePalisade</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>

