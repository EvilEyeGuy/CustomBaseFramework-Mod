  <CustomBaseFramework.SettlementPlanDef>
    <defName>CBF_Plan_WD_VFEM2_FarmCamp</defName>
    <label>farm camp (VFE Medieval 2)</label>
    <materialList>CBF_VFEM2_MaterialList</materialList>
    <styles>
      <li>CBF_VFEM2</li>
    </styles>
    <coreSize>34~42</coreSize>
    <mapSize>175</mapSize>
    <towerCorner>5</towerCorner>
    <towerCurtain>7</towerCurtain>
    <towerCapTotal>0</towerCapTotal>
    <wallGap>1</wallGap>
    <roadMain>2</roadMain>
    <roadLane>2</roadLane>
    <minBuildingGap>1</minBuildingGap>
    <maxBuildingGap>3</maxBuildingGap>
    <targetBuilt>0.45</targetBuilt>
    <weightNearRoad>1.4</weightNearRoad>
    <defenderPoints>80~160</defenderPoints>
    <defendersOnWall>0.25</defendersOnWall>
    <wards>
      <li>
        <kind>Town</kind>
        <name>Lager</name>
        <supply>1.2</supply>
        <walls>
          <li>Palisade</li>
        </walls>
        <emplacements>
          <li><tag>CBF_VFEM2_PalisadeTower</tag><count>1~1</count></li>
        </emplacements>
        <garrison>
          <li><list>CBF_VFEM2_Garrison_Inside</list><post>Inside</post><count>2~4</count></li>
        </garrison>
        <districts>
          <li>
            <name>Hof</name>
            <entries>
              <li><tag>CBF_VFEM2_Granary</tag><count>1~2</count></li>
              <li><tag>CBF_VFEM2_Farmstead</tag><count>1~2</count></li>
              <li><tag>CBF_VFEM2_Hut</tag><count>3~6</count><filler>true</filler></li>
            </entries>
          </li>
        </districts>
      </li>
      <li>
        <kind>Rural</kind>
        <name>Umland</name>
        <supply>1.2</supply>
        <districts>
          <li>
            <name>Felder</name><fields><li>
                <count>2~3</count>
                <fence>false</fence>
                <weight>1</weight><plants>
                  <li>Plant_Corn</li>
                  <li>Plant_Potato</li>
                </plants>
                <tags>
                  <li>CBF_VFEM2_Granary</li>
                  <li>CBF_VFEM2_Barn</li>
                </tags></li></fields>
            <entries>
              <li><tag>CBF_VFEM2_Pen</tag><count>1~2</count></li>
              <li><tag>CBF_VFEM2_Barn</tag><count>0~1</count></li>
            </entries>
          </li>
        </districts>
      </li>
    </wards>
    <kind>MedievalTown</kind>
    <factionTags>
      <li>VFEM2_KingdomCivil</li>
      <li>VFEM2_KingdomRough</li>
      <li>VFEM2_KingdomSavage</li>
      
      
      
      
    </factionTags>
    <share>0</share>
    <wdLevel>1</wdLevel>
    <wdType>
      <li>Farming</li>
    </wdType>
    <forAllFactions>true</forAllFactions>
    <techLevels>
      <li>Medieval</li>
    </techLevels>
    <worldTexture>World/WorldObjects/CBF/CBF_VillagePalisade</worldTexture>
  </CustomBaseFramework.SettlementPlanDef>

