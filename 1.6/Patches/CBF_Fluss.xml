<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/TileMutatorDef[defName="River"]/workerClass</xpath>
    <value>
      <workerClass>CustomBaseFramework.CBF_RiverWorker</workerClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TileMutatorDef[defName="RiverDelta"]/workerClass</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/TileMutatorDef[defName="RiverDelta"]/workerClass</xpath>
      <value>
        <workerClass>CustomBaseFramework.CBF_RiverDeltaWorker</workerClass>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TileMutatorDef[defName="RiverIsland"]/workerClass</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/TileMutatorDef[defName="RiverIsland"]/workerClass</xpath>
      <value>
        <workerClass>CustomBaseFramework.CBF_RiverIslandWorker</workerClass>
      </value>
    </match>
  </Operation>

</Patch>
